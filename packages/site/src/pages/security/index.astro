---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const pages = (await getCollection('security')).sort(
  (a, b) => a.data.order - b.data.order
);

// The advisory posts already live on the blog and are the canonical write-ups.
// This hub points at them; it does not restate them.
//
// Listed on the `advisory` flag, not on the `security` tag. The tag is a
// subject and four posts wear it — rate limiting, the approval gate, the 1.5
// release — so tag-matching filled a section headed "Advisories" with feature
// announcements, on the one page that opens by promising an honest boundary.
const advisories = (await getCollection('blog'))
  .filter(p => !p.data.draft && p.data.advisory)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base
  title="Security | MCP Hangar"
  description="Hangar's security posture in the open: an MCP-ecosystem CVE ledger, an honest OWASP MCP Top 10 coverage map — including the categories that are out of scope by design — and the published advisories."
  path="/security"
>
  <main class="max-w-4xl mx-auto px-6 py-16">
    <header class="mb-14">
      <div class="font-mono text-xs font-semibold text-zinc-500 uppercase tracking-[0.16em] mb-3">
        Security
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-zinc-50 mb-5 leading-tight text-balance">
        The posture, written down — including what it does not cover.
      </h1>
      <p class="text-lg text-zinc-400 leading-relaxed max-w-2xl">
        Hangar enforces deterministic policy on the MCP call path and records
        what happened. That draws a boundary, and a security page is only worth
        reading if it draws it honestly. These pages track the CVEs that matter
        to anyone running MCP servers, and map Hangar against the OWASP MCP Top
        10 — marking the categories that are out of scope by design rather than
        claiming them.
      </p>
    </header>

    <!-- The collection: one card per posture page. -->
    <section aria-labelledby="posture" class="mb-16">
      <h2 id="posture" class="font-mono text-sm font-semibold text-zinc-300 uppercase tracking-[0.16em] mb-5">
        Posture pages
      </h2>
      <ul class="grid gap-4 sm:grid-cols-2">
        {pages.map(p => (
          <li>
            <a
              href={`/security/${p.id}`}
              class="group flex h-full flex-col rounded-2xl bg-zinc-900/40 border border-zinc-800/60 hover:border-zinc-600/60 hover:bg-zinc-900/60 px-5 py-5 transition-colors"
            >
              <span class="flex items-start justify-between gap-3 mb-2">
                <span class="text-base font-semibold text-zinc-200 group-hover:text-zinc-50 transition-colors text-balance">
                  {p.data.title}
                </span>
                <span class="text-zinc-600 group-hover:text-zinc-300 group-hover:translate-x-0.5 transition-all shrink-0" aria-hidden="true">&rarr;</span>
              </span>
              <span class="text-sm text-zinc-400 leading-relaxed flex-1">{p.data.description}</span>
              <span class="mt-4 text-xs text-zinc-600 font-mono">Updated {fmtDate(p.data.updated)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- Advisories stay on the blog; this is a signpost, not a second copy. -->
    <section aria-labelledby="advisories" class="mb-16">
      <div class="flex flex-wrap items-baseline justify-between gap-3 mb-5">
        <h2 id="advisories" class="font-mono text-sm font-semibold text-zinc-300 uppercase tracking-[0.16em]">
          Advisories
        </h2>
        <a href="/blog" class="text-sm text-zinc-500 hover:text-zinc-300 transition-colors">
          All posts
        </a>
      </div>
      <p class="text-sm text-zinc-500 mb-5 max-w-2xl">
        Every advisory is published in full on the blog. The ledger summarises
        and links to them — it does not replace them.
      </p>
      <ul class="divide-y divide-zinc-800/60 border-y border-zinc-800/60">
        {advisories.map(a => (
          <li>
            <a
              href={`/blog/${a.id}`}
              class="group flex flex-wrap items-baseline gap-x-4 gap-y-1 py-4 transition-colors"
            >
              <span class="font-mono text-xs text-zinc-600 shrink-0 w-24">{fmtDate(a.data.date)}</span>
              <span class="text-zinc-300 group-hover:text-zinc-100 transition-colors flex-1 min-w-0">{a.data.title}</span>
              <span class="text-zinc-700 group-hover:text-zinc-400 transition-colors shrink-0" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
        {advisories.length === 0 && (
          <li class="py-4 text-sm text-zinc-500">No advisories published yet.</li>
        )}
      </ul>
    </section>

    <section aria-labelledby="reporting">
      <h2 id="reporting" class="font-mono text-sm font-semibold text-zinc-300 uppercase tracking-[0.16em] mb-5">
        Reporting a vulnerability
      </h2>
      <p class="text-sm text-zinc-400 leading-relaxed max-w-2xl mb-4">
        Found something in Hangar itself? The disclosure process — where to send
        it and what to expect — is in the docs. Please do not open a public
        issue for a security report.
      </p>
      <a
        href="/docs/security"
        class="inline-flex items-center gap-2 text-sm font-semibold text-zinc-200 hover:text-zinc-50 transition-colors"
      >
        Security policy &amp; disclosure
        <span aria-hidden="true">&rarr;</span>
      </a>
    </section>
  </main>
</Base>
