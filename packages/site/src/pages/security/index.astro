---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import AdvisoryList from '../../components/AdvisoryList.astro';

const ADVISORIES_URL = 'https://github.com/mcp-hangar/mcp-hangar/security/advisories';

const pages = (await getCollection('security')).sort(
  (a, b) => a.data.order - b.data.order
);

// Blog posts that write an advisory up at length. Not the advisory list itself:
// that is core's GitHub advisories, rendered by AdvisoryList.
//
// Listed on the `advisory` flag, not on the `security` tag. The tag is a
// subject and four posts wear it — rate limiting, the approval gate, the 1.5
// release — so tag-matching filled a section headed "Advisories" with feature
// announcements, on the one page that opens by promising an honest boundary.
const writeUps = (await getCollection('blog'))
  .filter(p => !p.data.draft && p.data.advisory)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base
  title="Security | MCP Hangar"
  description="Hangar's security posture in the open: an MCP-ecosystem CVE ledger, an honest OWASP MCP Top 10 coverage map — including the categories that are out of scope by design — and the published advisories."
  path="/security"
>
  <main class="max-w-4xl mx-auto px-6 py-16">
    <header class="mb-14">
      <div class="font-mono text-xs font-semibold text-ink-3 uppercase tracking-[0.16em] mb-3">
        Security
      </div>
      <h1 class="text-h1 text-ink mb-5 text-balance">
        The posture, written down — including what it does not cover.
      </h1>
      <p class="text-lead text-ink-3 max-w-2xl">
        Hangar enforces deterministic policy on the MCP call path and records
        what happened. That draws a boundary, and a security page is only worth
        reading if it draws it honestly. These pages track the CVEs that matter
        to anyone running MCP servers, and map Hangar against the OWASP MCP Top
        10 — marking the categories that are out of scope by design rather than
        claiming them.
      </p>
    </header>

    <!-- The collection: one card per posture page. -->
    <section aria-labelledby="posture" class="mb-16">
      <h2 id="posture" class="font-mono text-sm font-semibold text-ink-2 uppercase tracking-[0.16em] mb-5">
        Posture pages
      </h2>
      <ul class="grid gap-4 sm:grid-cols-2">
        {pages.map(p => (
          <li>
            <a
              href={`/security/${p.id}`}
              class="group flex h-full flex-col rounded-2xl bg-panel border border-rule hover:border-rule-strong hover:bg-panel px-5 py-5 transition-colors"
            >
              <span class="flex items-start justify-between gap-3 mb-2">
                <span class="text-base font-semibold text-ink group-hover:text-ink transition-colors text-balance">
                  {p.data.title}
                </span>
                <span class="text-ink-3 group-hover:text-ink-2 group-hover:translate-x-0.5 transition-all shrink-0" aria-hidden="true">&rarr;</span>
              </span>
              <span class="text-sm text-ink-3 leading-relaxed flex-1">{p.data.description}</span>
              <span class="mt-4 text-xs text-ink-3 font-mono">Updated {fmtDate(p.data.updated)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- Hangar's own advisories are GitHub security advisories on core. The
         list is built from a committed snapshot of the published ones
         (scripts/refresh-advisories.mjs), so it cannot fall behind the way a
         hand-kept list did: this section once said every advisory was on the
         blog while listing one, after ten had been published on GitHub. -->
    <section aria-labelledby="advisories" class="mb-16">
      <div class="flex flex-wrap items-baseline justify-between gap-3 mb-5">
        <h2 id="advisories" class="font-mono text-sm font-semibold text-ink-2 uppercase tracking-[0.16em]">
          Advisories
        </h2>
        <a
          href={ADVISORIES_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-ink-3 hover:text-ink transition-colors"
        >
          On GitHub
        </a>
      </div>
      <p class="text-sm text-ink-3 mb-5 max-w-2xl">
        Vulnerabilities in Hangar itself are disclosed as GitHub security
        advisories on <span class="font-mono">mcp-hangar/mcp-hangar</span>. This
        list is built from the published ones; each entry links to the full
        advisory, with affected versions and upgrade guidance.
      </p>
      <AdvisoryList />

      {writeUps.length > 0 && (
        <>
          <h3 class="font-mono text-xs font-semibold text-ink-3 uppercase tracking-[0.16em] mt-10 mb-3">
            Write-ups on the blog
          </h3>
          <ul class="divide-y divide-rule border-y border-rule">
            {writeUps.map(a => (
              <li>
                <a
                  href={`/blog/${a.id}`}
                  class="group flex flex-wrap items-baseline gap-x-4 gap-y-1 py-4 transition-colors"
                >
                  <span class="font-mono text-xs text-ink-3 shrink-0 w-24">{fmtDate(a.data.date)}</span>
                  <span class="text-ink-2 group-hover:text-ink transition-colors flex-1 min-w-0">{a.data.title}</span>
                  <span class="text-rule-strong group-hover:text-ink-3 transition-colors shrink-0" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </>
      )}
    </section>

    <section aria-labelledby="reporting">
      <h2 id="reporting" class="font-mono text-sm font-semibold text-ink-2 uppercase tracking-[0.16em] mb-5">
        Reporting a vulnerability
      </h2>
      <p class="text-sm text-ink-3 leading-relaxed max-w-2xl mb-4">
        Found something in Hangar itself? The disclosure process — where to send
        it and what to expect — is in the docs. Please do not open a public
        issue for a security report.
      </p>
      <a
        href="/docs/security"
        class="inline-flex items-center gap-2 text-sm font-semibold text-ink hover:text-ink transition-colors"
      >
        Security policy &amp; disclosure
        <span aria-hidden="true">&rarr;</span>
      </a>
    </section>
  </main>
</Base>
