---
import Base from '../layouts/Base.astro';
import { ALTERNATIVES, CAPABILITIES, HANGAR, VERIFIED, type Cell, type Project } from '../data/compare';

const rows: Project[] = [HANGAR, ...ALTERNATIVES];
const short = (sha: string) => sha.slice(0, 7);
const label: Record<Cell['verdict'], string> = { yes: 'Yes', partial: 'Partial', no: 'No' };
const cell = (p: Project, key: (typeof CAPABILITIES)[number]['key']): Cell => p[key];
const link = 'text-ink-2 underline underline-offset-2 decoration-rule-strong hover:text-ink';
---

<Base
    title="Compare MCP gateways | MCP Hangar"
    description="Which MCP gateways pin tool contracts, hold calls for approval, express MCP policy as Kubernetes objects and scope policy per tenant, with a link to the code for every claim."
    path="/compare"
>
    <main class="max-w-5xl mx-auto px-4 sm:px-6 py-20">
        <h1 class="text-h1 text-ink mb-3">How Hangar compares</h1>
        <p class="text-ink-2 max-w-3xl mb-2">
            Buyers' tables of MCP gateways list transports, authentication and registries. They have no row for
            the four things below. This page states, for each project, whether its code implements them, and links
            the code. Every claim was read in source at the commit shown, not taken from a README.
        </p>
        <p class="text-sm text-ink-3 mb-12">
            Last verified {VERIFIED}. Re-verified quarterly. Found a mistake?
            <a class={link} href="https://github.com/mcp-hangar/mcp-hangar-website/issues/new">Open an issue</a>
            and it comes off the page.
        </p>

        <section class="mb-14">
            <h2 class="text-lg font-semibold text-ink mb-4">What is compared</h2>
            <dl class="grid sm:grid-cols-2 gap-x-8 gap-y-4 text-sm">
                {CAPABILITIES.map((c) => (
                    <div>
                        <dt class="font-semibold text-ink">{c.label}</dt>
                        <dd class="text-ink-2">{c.detail}</dd>
                    </div>
                ))}
            </dl>
        </section>

        <section class="mb-14">
            <h2 class="text-lg font-semibold text-ink mb-4">At a glance</h2>
            <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Capability comparison">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="border-b border-rule">
                            <th class="py-2 pr-4 text-ink">Project</th>
                            {CAPABILITIES.map((c) => <th class="py-2 pr-4 text-ink">{c.label}</th>)}
                        </tr>
                    </thead>
                    <tbody>
                        {rows.map((p) => (
                            <tr class="border-b border-rule align-top">
                                <th scope="row" class="py-2 pr-4 font-normal">
                                    <a class={link} href={`https://github.com/${p.repo}/tree/${p.sha}`}>{p.name}</a>
                                    <span class="block font-mono text-xs text-ink-3">{short(p.sha)}</span>
                                </th>
                                {CAPABILITIES.map((c) => {
                                    const v = cell(p, c.key);
                                    return (
                                        <td class="py-2 pr-4 text-ink-2">
                                            {v.href ? <a class={link} href={v.href}>{label[v.verdict]}</a> : label[v.verdict]}
                                        </td>
                                    );
                                })}
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
            <p class="mt-3 text-sm text-ink-3">
                Each verdict links to the code that supports it. A "No" without a link means the code was searched
                and nothing was found; what was searched for is in the notes below.
            </p>
        </section>

        <section class="mb-14 space-y-10">
            <h2 class="text-lg font-semibold text-ink">Project by project</h2>
            {rows.map((p) => (
                <article>
                    <h3 class="font-semibold text-ink mb-1">{p.name}</h3>
                    <p class="font-mono text-xs text-ink-3 mb-3">{p.repo} at {p.sha}</p>
                    <ul class="list-disc pl-6 space-y-1 text-sm text-ink-2">
                        {CAPABILITIES.map((c) => {
                            const v = cell(p, c.key);
                            return (
                                <li>
                                    <span class="text-ink">{c.label}: {label[v.verdict]}.</span> {v.note}
                                    {v.href && <> <a class={link} href={v.href}>Code</a></>}
                                </li>
                            );
                        })}
                    </ul>
                    {p.stronger.length > 0 && (
                        <>
                            <p class="mt-3 text-sm text-ink">Where it is stronger than Hangar</p>
                            <ul class="list-disc pl-6 space-y-1 text-sm text-ink-2">
                                {p.stronger.map((s) => <li>{s}</li>)}
                            </ul>
                        </>
                    )}
                </article>
            ))}
        </section>

        <section>
            <h2 class="text-lg font-semibold text-ink mb-3">Where Hangar is weaker</h2>
            <ul class="list-disc pl-6 space-y-1 text-sm text-ink-2">
                <li>Drift is one verdict. pipelock tells a description-only change from a structural one and names the cue that triggered it; Hangar withholds the tool and reports digest_drift.</li>
                <li>Ecosystem and first contact. ToolHive ships a large catalog and standalone quickstarts on two paths; Hangar has one local quickstart and one cluster path.</li>
                <li>Throughput. Hangar is a Python control point; agentgateway is a Rust data plane built for traffic volume across MCP, A2A and LLM calls.</li>
                <li>Gateway-native integration. Kuadrant and agentgateway plug into Gateway API and Envoy policy you may already run; Hangar brings its own CRDs and operator.</li>
            </ul>
        </section>
    </main>
</Base>
