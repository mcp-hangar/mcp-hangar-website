---
import Base from '../../layouts/Base.astro';
import BlogByline from '../../components/BlogByline.astro';
import Tag from '../../components/Tag.astro';
import { render } from 'astro:content';
import { publishedPosts } from '../../lib/blog';
import { blogPostingSchema, toJsonLd } from '../../lib/article-jsonld';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Get prev/next posts
const allPosts = (await publishedPosts()).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const currentIndex = allPosts.findIndex(p => p.id === post.id);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;

// Article-level structured data, alongside — never inside — the site-wide
// SoftwareApplication block that Base.astro emits. `Astro.site` is the same
// origin the canonical tag and the sitemap are built from, so there is one
// spelling of the domain rather than a second one drifting here.
const siteUrl = Astro.site!.origin;
const articleJsonLd = toJsonLd(
  blogPostingSchema({
    slug: post.id,
    title: post.data.title,
    description: post.data.description,
    date: post.data.date,
    updated: post.data.updated,
    author: post.data.author,
    siteUrl,
  }),
);
---

<Base 
  title={`${post.data.title} | Blog | MCP Hangar`} 
  description={post.data.description} 
  path={`/blog/${post.id}`}
>
  <script is:inline type="application/ld+json" set:html={articleJsonLd} />

  <main class="max-w-3xl mx-auto px-6 py-16">
    <!-- Back link -->
    <a href="/blog" class="inline-flex items-center gap-1.5 text-sm text-ink-3 hover:text-ink-2 transition-colors mb-8 group">
      <span class="group-hover:-translate-x-0.5 transition-transform">&larr;</span>
      All posts
    </a>

    <article class="prose max-w-none docs-article" data-pagefind-body data-pagefind-filter="section:Blog">
      <header class="not-prose mb-10">
        {post.data.tags && (
          <div class="flex flex-wrap gap-2 mb-4">
            {post.data.tags.map(tag => (
              <Tag>{tag}</Tag>
            ))}
          </div>
        )}
        <p class="font-mono text-xs text-ink-3 mb-3">blog · {post.data.date.toISOString().slice(0, 10)}</p>
        <h1 class="text-h1 text-ink mb-4">{post.data.title}</h1>
        <BlogByline date={post.data.date} author={post.data.author} />
      </header>
      
      <div class="mt-8 blog-content">
        <Content />
      </div>
    </article>

    <!-- Prev/Next navigation -->
    {(prevPost || nextPost) && (
      <nav aria-label="More posts" class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-4">
        {nextPost ? (
          <a href={`/blog/${nextPost.id}`} class="group py-4 border-t border-rule">
            <span class="font-mono text-xs text-ink-3">older</span>
            <p class="text-sm text-ink-2 font-semibold mt-1 group-hover:text-ink transition-colors">{nextPost.data.title}</p>
          </a>
        ) : <div />}
        {prevPost && (
          <a href={`/blog/${prevPost.id}`} class="group py-4 border-t border-rule md:text-right">
            <span class="font-mono text-xs text-ink-3">newer</span>
            <p class="text-sm text-ink-2 font-semibold mt-1 group-hover:text-ink transition-colors">{prevPost.data.title}</p>
          </a>
        )}
      </nav>
    )}
  </main>
</Base>
