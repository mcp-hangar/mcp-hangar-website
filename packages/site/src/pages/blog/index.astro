---
import Base from '../../layouts/Base.astro';
import BlogByline from '../../components/BlogByline.astro';
import Tag from '../../components/Tag.astro';
import { publishedPosts } from '../../lib/blog';

const posts = await publishedPosts();
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [featured, ...rest] = sortedPosts;

/** ISO date in the data face, the way a record dates a line. */
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<Base title="Blog | MCP Hangar" description="Latest news and updates from the MCP Hangar team." path="/blog">
  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    <header class="mb-10">
      <p class="font-mono text-xs text-ink-3 mb-3">blog · {sortedPosts.length} posts</p>
      <h1 class="text-h1 text-ink mb-3">Blog</h1>
      <p class="text-lead text-ink-2">Engineering updates from the MCP Hangar team.</p>
    </header>

    <!-- The latest post leads; the rest is a register, newest first. -->
    {featured && (
      <a href={`/blog/${featured.id}`} class="group block border-t border-ink pt-6 pb-10">
        <article>
          <p class="font-mono text-xs text-ink-3 mb-3">latest · {iso(featured.data.date)}</p>
          <h2 class="text-h2 text-ink mb-3 group-hover:underline underline-offset-4 decoration-2">
            {featured.data.title}
          </h2>
          <p class="text-lead text-ink-2 max-w-3xl mb-4">{featured.data.description}</p>
          <BlogByline date={featured.data.date} author={featured.data.author} />
          {featured.data.tags && (
            <div class="flex flex-wrap gap-1.5 mt-4">
              {featured.data.tags.map(tag => <Tag>{tag}</Tag>)}
            </div>
          )}
        </article>
      </a>
    )}

    {rest.length > 0 && (
      <ol class="border-t border-rule">
        {rest.map(post => (
          <li class="border-b border-rule">
            <a href={`/blog/${post.id}`} class="group grid gap-x-8 gap-y-1 py-5 md:grid-cols-[7rem_minmax(0,1fr)]">
              <span class="font-mono text-sm text-ink-3 tabular-nums md:pt-0.5">{iso(post.data.date)}</span>
              <article class="min-w-0">
                <h2 class="text-h3 text-ink group-hover:underline underline-offset-4">{post.data.title}</h2>
                <p class="mt-1 text-ink-3 line-clamp-2">{post.data.description}</p>
                {post.data.tags && (
                  <div class="flex flex-wrap gap-1.5 mt-2">
                    {post.data.tags.map(tag => <Tag>{tag}</Tag>)}
                  </div>
                )}
              </article>
            </a>
          </li>
        ))}
      </ol>
    )}
  </main>
</Base>
