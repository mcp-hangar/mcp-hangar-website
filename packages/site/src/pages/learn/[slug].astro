---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { isUpcoming, sinceLabel } from '../../lib/version-badge';
import { trackPosition } from '../../lib/learn-track';

export async function getStaticPaths() {
  const entries = await getCollection('learn');
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Facet presentation — mirrors the /learn hub so a reader landing here sees the
// same signals: type badge in its color, level, time, and the release pill.
const TC: Record<string, string> = {
  Concept: '#2dd4bf',
  Tutorial: '#38bdf8',
  Why: '#a78bfa',
  Visual: '#fbbf24',
};
const TLABEL: Record<string, string> = {
  Concept: 'Concept',
  Tutorial: 'Tutorial',
  Why: 'Deep dive',
  Visual: 'Visual',
};
const { type, level, time, since } = entry.data;
const typeColor = TC[type];
const upcoming = isUpcoming(since);

// Where this page sits in the guided track, and what it hands off to. Without
// this a reader finishing a page had nowhere to go: eight of the sixteen pages
// linked to no sibling at all.
const track = trackPosition(entry.id);
const allEntries = await getCollection('learn');
const titleOf = new Map(allEntries.map(e => [e.id, e.data.title]));
---

<Base
  title={`${entry.data.title} | Learn | MCP Hangar`}
  description={entry.data.description}
  path={`/learn/${entry.id}`}
>
  <main class="max-w-3xl mx-auto px-6 py-16">
    <!-- Back link -->
    <a href="/learn" class="inline-flex items-center gap-1.5 text-sm text-zinc-500 hover:text-zinc-300 transition-colors mb-8 group">
      <span class="group-hover:-translate-x-0.5 transition-transform">&larr;</span>
      All concepts
    </a>

    <article class="prose prose-invert max-w-none docs-article">
      <header class="not-prose mb-10">
        <!-- Compact facet meta row — same signals as the /learn hub cards. -->
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-4 text-xs">
          <span
            class="inline-flex items-center gap-1.5 font-semibold"
            style={`color:${typeColor}`}
          >
            <span class="w-2 h-2 rounded-sm" style={`background:${typeColor}`} />
            {TLABEL[type]}
          </span>
          <span class="w-1 h-1 rounded-full bg-zinc-600" aria-hidden="true" />
          <span class="text-zinc-400">{level}</span>
          <span class="w-1 h-1 rounded-full bg-zinc-600" aria-hidden="true" />
          <span class="text-zinc-400 font-mono">{time}</span>
          <span
            class:list={[
              'ml-auto px-2 py-0.5 rounded font-semibold',
              upcoming
                ? 'bg-zinc-500/10 text-zinc-400'
                : 'bg-zinc-800/40 text-zinc-300',
            ]}
          >
            {sinceLabel(since)}
          </span>
        </div>
        {entry.data.tags && (
          <div class="flex flex-wrap items-center gap-2 mb-4">
            {entry.data.tags.map(tag => (
              <span class="px-2 py-0.5 text-xs rounded-md bg-zinc-800/70 text-zinc-500 border border-zinc-700/50">
                {tag}
              </span>
            ))}
          </div>
        )}
        <h1 class="text-3xl md:text-4xl font-bold text-zinc-50 mb-4 leading-tight">{entry.data.title}</h1>
        <p class="text-sm text-zinc-500">Updated {fmtDate(entry.data.updated)}</p>
      </header>

      <div class="mt-8 blog-content">
        <Content />
      </div>
    </article>

    <footer class="mt-16 pt-10 border-t border-zinc-800/60">
      {track.deeper.length > 0 && (
        <div class="mb-12">
          <h2 class="font-mono text-sm font-semibold text-zinc-300 uppercase tracking-[0.16em] mb-5">
            Go deeper in the docs
          </h2>
          <ul class="grid gap-3 sm:grid-cols-2">
            {track.deeper.map(d => (
              <li>
                <a
                  href={d.href}
                  class="group flex items-center justify-between gap-3 rounded-xl bg-zinc-900/40 border border-zinc-800/60 hover:border-zinc-600/60 hover:bg-zinc-900/60 px-4 py-3.5 transition-colors"
                >
                  <span class="text-base text-zinc-300 group-hover:text-zinc-100 transition-colors">{d.label}</span>
                  <span class="text-zinc-600 group-hover:text-zinc-300 group-hover:translate-x-0.5 transition-all shrink-0" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {track.index !== null && (
        <nav aria-label="Learn track">
          <div class="flex items-center justify-between gap-4 mb-5">
            <span class="font-mono text-xs text-zinc-500 uppercase tracking-wider">
              Step {track.index} of {track.total} &middot; Learn track
            </span>
            <a href="/learn" class="text-sm text-zinc-500 hover:text-zinc-300 transition-colors">
              All concepts
            </a>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            {track.prev && (
              <a
                href={`/learn/${track.prev}`}
                class="group rounded-xl bg-zinc-900/40 border border-zinc-800/60 hover:border-zinc-600/60 hover:bg-zinc-900/60 px-5 py-4 transition-colors"
              >
                <span class="flex items-center gap-1.5 text-xs font-semibold text-zinc-500 uppercase tracking-wider mb-1.5">
                  <span class="group-hover:-translate-x-0.5 transition-transform" aria-hidden="true">&larr;</span>
                  Previous
                </span>
                <span class="block text-base font-medium text-zinc-200 group-hover:text-zinc-100 transition-colors text-balance">
                  {titleOf.get(track.prev)}
                </span>
              </a>
            )}
            {track.next && (
              <a
                href={`/learn/${track.next}`}
                class={`group rounded-xl bg-zinc-900/40 border border-zinc-800/60 hover:border-zinc-600/60 hover:bg-zinc-900/60 px-5 py-4 transition-colors sm:text-right ${track.prev ? '' : 'sm:col-start-2'}`}
              >
                <span class="flex items-center gap-1.5 text-xs font-semibold text-zinc-500 uppercase tracking-wider mb-1.5 sm:justify-end">
                  Next
                  <span class="group-hover:translate-x-0.5 transition-transform" aria-hidden="true">&rarr;</span>
                </span>
                <span class="block text-base font-medium text-zinc-200 group-hover:text-zinc-100 transition-colors text-balance">
                  {titleOf.get(track.next)}
                </span>
              </a>
            )}
          </div>
        </nav>
      )}
    </footer>
  </main>
</Base>
