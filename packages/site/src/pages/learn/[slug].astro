---
import Base from '../../layouts/Base.astro';
import Tag from '../../components/Tag.astro';
import { getCollection, render } from 'astro:content';
import { isUpcoming, sinceLabel } from '../../lib/version-badge';
import { trackPosition } from '../../lib/learn-track';

export async function getStaticPaths() {
  const entries = (await getCollection('learn')).filter(e => !e.data.draft);
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Facet presentation — mirrors the /learn hub so a reader landing here sees the
// same signals: type badge, level, time, and the release pill.
//
// The badge is neutral. It used to carry a hue per type — teal, sky, violet,
// amber — which the hub dropped for the reason its own stylesheet still gives:
// the type is already named in the label beside the dot, so the colour added
// four competitors to a palette where a hue is supposed to mean a verdict.
// This page kept them, so the same article was neutral in the grid and
// coloured once you opened it.
const TLABEL: Record<string, string> = {
  Concept: 'Concept',
  Tutorial: 'Tutorial',
  Why: 'Deep dive',
  Visual: 'Visual',
};
const { type, level, time, since } = entry.data;
const upcoming = isUpcoming(since);

// Where this page sits in the guided track, and what it hands off to. Without
// this a reader finishing a page had nowhere to go: eight of the sixteen pages
// linked to no sibling at all.
const track = trackPosition(entry.id);
const allEntries = await getCollection('learn');
const titleOf = new Map(allEntries.map(e => [e.id, e.data.title]));
---

<Base
  title={`${entry.data.title} | Learn | MCP Hangar`}
  description={entry.data.description}
  path={`/learn/${entry.id}`}
>
  <main class="max-w-3xl mx-auto px-6 py-16">
    <!-- Back link -->
    <a href="/learn" class="inline-flex items-center gap-1.5 text-sm text-ink-3 hover:text-ink-2 transition-colors mb-8 group">
      <span class="group-hover:-translate-x-0.5 transition-transform">&larr;</span>
      All concepts
    </a>

    <article class="prose max-w-none docs-article" data-pagefind-body data-pagefind-filter="section:Learn">
      <header class="not-prose mb-10">
        <!-- One mono line, the record's voice: the same facets as the /learn
             hub cards, as text rather than dots and pills. -->
        <p class="flex flex-wrap items-baseline gap-x-2 gap-y-1 mb-4 font-mono text-xs text-ink-3">
          <span>learn</span><span aria-hidden="true">·</span>
          <span>{TLABEL[type].toLowerCase()}</span><span aria-hidden="true">·</span>
          <span>{level.toLowerCase()}</span><span aria-hidden="true">·</span>
          <span>{time}</span>
          <span class:list={['ml-auto', upcoming ? 'text-hold' : 'text-ink-2']}>{sinceLabel(since).toLowerCase()}</span>
        </p>
        {entry.data.tags && (
          <div class="flex flex-wrap items-center gap-2 mb-4">
            {entry.data.tags.map(tag => (
              <Tag>{tag}</Tag>
            ))}
          </div>
        )}
        <h1 class="text-h1 text-ink mb-4">{entry.data.title}</h1>
        <p class="text-sm text-ink-3">Updated {fmtDate(entry.data.updated)}</p>
      </header>

      <div class="mt-8 blog-content">
        <Content />
      </div>
    </article>

    <footer class="mt-16 pt-10 border-t border-rule">
      {track.deeper.length > 0 && (
        <div class="mb-12">
          <h2 class="font-mono text-sm font-semibold text-ink-2 uppercase tracking-[0.16em] mb-5">
            Go deeper in the docs
          </h2>
          <ul class="grid gap-3 sm:grid-cols-2">
            {track.deeper.map(d => (
              <li>
                <a
                  href={d.href}
                  class="group flex items-center justify-between gap-3 rounded-md bg-panel border border-rule hover:border-rule-strong hover:bg-panel px-4 py-3.5 transition-colors"
                >
                  <span class="text-base text-ink-2 group-hover:text-ink transition-colors">{d.label}</span>
                  <span class="text-ink-3 group-hover:text-ink-2 group-hover:translate-x-0.5 transition-all shrink-0" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {track.index !== null && (
        <nav aria-label="Learn track">
          <div class="flex items-center justify-between gap-4 mb-5">
            <span class="font-mono text-xs text-ink-3 uppercase tracking-wider">
              Step {track.index} of {track.total} &middot; Learn track
            </span>
            <a href="/learn" class="text-sm text-ink-3 hover:text-ink-2 transition-colors">
              All concepts
            </a>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            {track.prev && (
              <a
                href={`/learn/${track.prev}`}
                class="group rounded-md bg-panel border border-rule hover:border-rule-strong hover:bg-panel px-5 py-4 transition-colors"
              >
                <span class="flex items-center gap-1.5 text-xs font-semibold text-ink-3 uppercase tracking-wider mb-1.5">
                  <span class="group-hover:-translate-x-0.5 transition-transform" aria-hidden="true">&larr;</span>
                  Previous
                </span>
                <span class="block text-base font-semibold text-ink group-hover:text-ink transition-colors text-balance">
                  {titleOf.get(track.prev)}
                </span>
              </a>
            )}
            {track.next && (
              <a
                href={`/learn/${track.next}`}
                class={`group rounded-md bg-panel border border-rule hover:border-rule-strong hover:bg-panel px-5 py-4 transition-colors sm:text-right ${track.prev ? '' : 'sm:col-start-2'}`}
              >
                <span class="flex items-center gap-1.5 text-xs font-semibold text-ink-3 uppercase tracking-wider mb-1.5 sm:justify-end">
                  Next
                  <span class="group-hover:translate-x-0.5 transition-transform" aria-hidden="true">&rarr;</span>
                </span>
                <span class="block text-base font-semibold text-ink group-hover:text-ink transition-colors text-balance">
                  {titleOf.get(track.next)}
                </span>
              </a>
            )}
          </div>
        </nav>
      )}
    </footer>
  </main>
</Base>
