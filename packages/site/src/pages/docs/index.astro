---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getCollection } from 'astro:content';
import { countCookbookRecipes, DECISIONS_INDEX, isDecision } from '../../docsNav';
import { TIME_TO_VALUE } from '../../config';

const docs = await getCollection('oss');
const recipeCount = countCookbookRecipes(docs);

const decisionCount = docs.filter((d) => isDecision(d.id)).length;
const pageCount = docs.length - decisionCount;

// The same six sections as the sidebar (docsNav SECTIONS), each with the few
// pages a first visit wants; the sidebar has the rest.
const sections = [
  {
    title: 'Start',
    description: `Install MCP Hangar and watch it refuse a call, in about ${TIME_TO_VALUE.words}.`,
    links: [
      { href: '/docs/getting-started/quickstart', label: 'Quick Start' },
      { href: '/docs/getting-started/installation', label: 'Installation' },
      { href: '/docs/getting-started/releases', label: 'Releases' },
    ],
  },
  {
    title: 'Guides',
    description: 'One feature or deployment at a time.',
    links: [
      { href: '/docs/guides/HTTP_TRANSPORT', label: 'HTTP Transport' },
      { href: '/docs/guides/AUTHENTICATION', label: 'Authentication & RBAC' },
      { href: '/docs/guides/FRONT_DOOR', label: 'Front-Door Mode' },
      { href: '/docs/guides/EGRESS_POLICY', label: 'Egress Policy' },
      { href: '/docs/guides/KUBERNETES', label: 'Kubernetes' },
    ],
  },
  {
    title: 'Cookbook',
    description: `${recipeCount} recipes from zero to production.`,
    links: [
      { href: '/docs/cookbook/index', label: 'All Recipes' },
      { href: '/docs/cookbook/01-http-gateway', label: 'HTTP Gateway' },
      { href: '/docs/cookbook/12-auth-rbac', label: 'Auth & RBAC' },
      { href: '/docs/cookbook/13-production-checklist', label: 'Production Checklist' },
    ],
  },
  {
    title: 'Reference',
    description: 'Configuration, CLI, API, tools and architecture.',
    links: [
      { href: '/docs/reference/configuration', label: 'Configuration' },
      { href: '/docs/reference/cli', label: 'CLI' },
      { href: '/docs/reference/rest-api', label: 'REST API' },
      { href: '/docs/architecture/OVERVIEW', label: 'Architecture Overview' },
    ],
  },
  {
    title: 'Operate',
    description: 'Upgrades, compliance export, telemetry and runbooks.',
    links: [
      { href: '/docs/upgrade', label: 'Upgrade Guide' },
      { href: '/docs/operations/COMPLIANCE', label: 'Compliance Export' },
      { href: '/docs/observability/otel-integrations', label: 'OpenTelemetry' },
      { href: '/docs/runbooks/not-responding', label: 'Runbook: Not Responding' },
    ],
  },
  {
    title: 'Security',
    description: 'What a verdict guarantees, and where it stops.',
    links: [
      { href: '/docs/security', label: 'Security Policy' },
      { href: '/docs/security/VERDICT_LIMITS', label: 'Verdict Limits' },
      { href: '/docs/security/OWASP_MCP_TOP_10_COVERAGE', label: 'OWASP MCP Top 10' },
    ],
  },
];
---

<DocsLayout
  title="Documentation | MCP Hangar"
  description="Documentation for MCP Hangar: install it, configure it, run it in production, and know what its verdicts guarantee."
  path="/docs"
>
  <div class="space-y-10">
    <!-- Header -->
    <div>
      <h1 class="text-3xl font-bold text-zinc-100 mb-3">Documentation</h1>
      <p class="text-zinc-400 text-lg leading-relaxed max-w-2xl">
        Everything you need to install, configure, and run MCP Hangar in production.
        Start with the <a href="/docs/getting-started/quickstart" class="text-zinc-300 underline underline-offset-2 decoration-zinc-500 hover:text-zinc-100 hover:decoration-zinc-300 transition-colors">Quick Start</a> or explore the sections below.
      </p>
    </div>

    <!-- Section cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 stagger-grid">
      {sections.map((section) => (
        <div class="group p-5 rounded-xl bg-zinc-900/40 border border-zinc-800/60 hover:border-zinc-700/80 transition-all duration-300">
          <div class="mb-3">
            <h2 class="text-base font-semibold text-zinc-100 group-hover:text-zinc-300 transition-colors">
              {section.title}
            </h2>
            <p class="text-sm text-zinc-400 mt-0.5">{section.description}</p>
          </div>
          <ul class="space-y-1">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-zinc-400 hover:text-zinc-300 transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Footer note -->
    <div class="pt-6 border-t border-zinc-800/50">
      <p class="text-sm text-zinc-400">
        {pageCount} pages in the documentation, and{' '}
        <a href={DECISIONS_INDEX} class="text-zinc-300 underline underline-offset-2 decoration-zinc-500 hover:text-zinc-100 hover:decoration-zinc-300 transition-colors">{decisionCount} decision records</a>{' '}
        under Decisions.{' '}
        <a href="https://github.com/mcp-hangar/mcp-hangar" class="text-zinc-300 underline underline-offset-2 decoration-zinc-500 hover:text-zinc-100 hover:decoration-zinc-300 transition-colors">View source on GitHub</a>
      </p>
    </div>
  </div>
</DocsLayout>
