---
/**
 * Decisions: the ADR index. ADRs left the docs sidebar (redesign D3) because
 * 29 design records between the guides and the runbooks made the product docs
 * read as an archive. Their pages keep their /docs/adr/* URLs -- nothing that
 * links to an ADR breaks -- and this page is the section's front door, also
 * where the docs repo's `adr/README.md` links now land.
 *
 * Number, title and status are read from each ADR (see parseDecision), so a
 * new ADR or a status change shows up here with the next docs pin.
 */
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { getCollection } from 'astro:content';
import { isDecision, parseDecision } from '../../../docsNav';

const docs = await getCollection('oss');
const decisions = docs
  .filter((d) => isDecision(d.id))
  .map(parseDecision)
  .sort((a, b) => a.number.localeCompare(b.number, 'en', { numeric: true }));
---

<DocsLayout
  title="Decisions | Docs | MCP Hangar"
  description="MCP Hangar's architecture decision records: what was decided, why, and whether it still stands."
  path="/docs/adr"
>
  <div class="space-y-8">
    <div>
      <h1 class="text-h1 text-ink mb-3">Decisions</h1>
      <p class="text-ink-3 text-lg leading-relaxed max-w-2xl">
        The architecture decision records behind MCP Hangar: the choice, the
        alternatives, and the consequences. A superseded record stays, so the
        reasoning that led to the current design can still be read.
      </p>
    </div>

    <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Decision records">
      <table class="w-full text-sm text-left">
        <thead class="text-xs uppercase tracking-wider text-ink-3 border-b border-rule">
          <tr>
            <th scope="col" class="py-2 pr-4 font-semibold">Number</th>
            <th scope="col" class="py-2 pr-4 font-semibold">Decision</th>
            <th scope="col" class="py-2 font-semibold">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-rule">
          {decisions.map((d) => (
            <tr>
              <td class="py-2.5 pr-4 font-mono text-ink-3 whitespace-nowrap align-top">{d.number}</td>
              <td class="py-2.5 pr-4 align-top">
                <a href={d.href} class="text-ink hover:text-ink underline underline-offset-2 decoration-rule-strong hover:decoration-rule-strong">{d.title}</a>
              </td>
              <td class="py-2.5 text-ink-3 align-top whitespace-nowrap">
                {d.status}{d.partlySuperseded && <span class="block text-xs text-ink-3">partly superseded</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="text-sm text-ink-3">
      {decisions.length} decision records. They are written in
      <a href="https://github.com/mcp-hangar/docs/tree/main/adr" class="text-ink-2 underline underline-offset-2 decoration-rule-strong hover:text-ink">mcp-hangar/docs</a>,
      where new ones are proposed.
    </p>
  </div>
</DocsLayout>
