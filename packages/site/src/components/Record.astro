---
import VerdictChip from "./VerdictChip.astro";

/**
 * The verdict record: the motif the whole site is built on.
 *
 * Rows of time | verdict | call and reason, the way Hangar writes them down.
 * Records are content, not decoration: every field shown here is one the
 * product actually emits (see src/data/core-gates.json for where each name
 * comes from), so a reader who copies a reason code into a search of their
 * own logs finds it.
 *
 * A real `<table>`, so a screen reader announces it as one and a printout
 * keeps its columns. On a phone the call and reason move to a line of their
 * own under the time and verdict, instead of scrolling the page sideways.
 */
export interface RecordRow {
    /** Wall clock, `HH:MM:SS`. */
    time: string;
    verdict: "allow" | "deny" | "hold";
    /** `server.tool`, as the record names it. */
    call: string;
    /** A bounded code or field list, e.g. `gate=tool_access reason=tool_not_in_access_policy`. */
    reason?: string;
}

interface Props {
    rows: RecordRow[];
    /** What the record is, for the table's accessible name and its caption. */
    label: string;
    /** Where the rows come from, e.g. `batch_call_refused`, shown in the header. */
    source?: string;
    class?: string;
}

const { rows, label, source, class: className = "" } = Astro.props;

/**
 * A reason is a run of `key=value` fields. Each one is set as its own unit so
 * a narrow cell wraps between fields, never inside one: on a phone
 * `reason=tool_not_in_access_policy` used to break as `…_acces` / `s_policy`.
 * The spaces between units stay in the text, so a copied row is unchanged.
 */
const fields = (reason: string) => reason.split(/\s+/).filter(Boolean);
---

<figure class={`record min-w-0 ${className}`}>
    <div class="record-frame" tabindex="0" role="region" aria-label={label}>
        <!-- Explicit roles: on a phone the rows are laid out as grids, and some
             engines drop a table's semantics once its display changes. -->
        <table role="table">
            <caption class="sr-only">{label}</caption>
            <thead role="rowgroup">
                <tr role="row">
                    <th scope="col" role="columnheader">time</th>
                    <th scope="col" role="columnheader">verdict</th>
                    <th scope="col" role="columnheader">
                        call · reason
                        {source && <span class="record-source">{source}</span>}
                    </th>
                </tr>
            </thead>
            <tbody role="rowgroup">
                {rows.map((row) => (
                    <tr role="row">
                        <td class="record-time" role="cell">{row.time}</td>
                        <td role="cell"><VerdictChip verdict={row.verdict} size="sm" /></td>
                        <td class="record-call" role="cell">
                            <span class="record-unit text-ink">{row.call}</span>
                            {row.reason && (
                                <span class="record-reason">
                                    {fields(row.reason).map((field, i) => (
                                        <Fragment>{i > 0 && " "}<span class="record-unit">{field}</span></Fragment>
                                    ))}
                                </span>
                            )}
                        </td>
                    </tr>
                ))}
            </tbody>
        </table>
    </div>
    {Astro.slots.has("default") && (
        <figcaption class="mt-3 text-sm text-ink-3">
            <slot />
        </figcaption>
    )}
</figure>

<style>
    .record-frame {
        background: var(--c-panel);
        border: 1px solid var(--c-rule);
        border-radius: 6px;
        overflow-x: auto;
    }
    .record-frame:focus-visible {
        outline: 2px solid var(--c-ink);
        outline-offset: 2px;
    }
    table {
        width: 100%;
        border-collapse: collapse;
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        line-height: 1.6;
    }
    th {
        text-align: left;
        font-weight: 400;
        font-size: 0.6875rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--c-ink-3);
        background: var(--c-subtle);
        padding: 0.4rem 0.75rem;
        border-bottom: 1px solid var(--c-rule);
        white-space: nowrap;
    }
    .record-source {
        float: right;
        text-transform: none;
        letter-spacing: 0;
    }
    td {
        padding: 0.45rem 0.75rem;
        border-bottom: 1px solid var(--c-rule);
        vertical-align: baseline;
    }
    tr:last-child td {
        border-bottom: 0;
    }
    td:first-child,
    td:nth-child(2) {
        white-space: nowrap;
        width: 1%;
    }
    .record-time {
        color: var(--c-ink-3);
        font-variant-numeric: tabular-nums;
    }
    /* Wrap between units, not inside them. An inline-block moves to the next
       line whole when it does not fit; only a single unit wider than the
       whole cell (a long digest, say) breaks inside, as a last resort.
       `anywhere`, not `break-word`: it also lowers the cell's min-content
       width, so the table narrows instead of widening the frame. */
    .record-unit {
        display: inline-block;
        max-width: 100%;
        overflow-wrap: anywhere;
    }
    .record-reason {
        color: var(--c-ink-3);
        margin-left: 0.6em;
    }
    /* On a phone the call and its reason take a line of their own, under
       the time and the verdict. Squeezed into the third column they had about
       190px, and `reason=tool_not_in_access_policy` alone needs 250. The header
       row stays for screen readers; on screen it would only repeat the order
       the cells already show. */
    @media (max-width: 40rem) {
        table,
        tbody {
            display: block;
        }
        thead {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip-path: inset(50%);
            white-space: nowrap;
        }
        tbody tr {
            display: grid;
            grid-template-columns: auto 1fr;
            align-items: baseline;
            border-bottom: 1px solid var(--c-rule);
        }
        tbody tr:last-child {
            border-bottom: 0;
        }
        td {
            border-bottom: 0;
            padding-left: 0.5rem;
            padding-right: 0.5rem;
        }
        td:first-child,
        td:nth-child(2) {
            width: auto;
        }
        .record-call {
            grid-column: 1 / -1;
            padding-top: 0;
        }
        .record-reason {
            display: block;
            margin-left: 0;
        }
    }
</style>
