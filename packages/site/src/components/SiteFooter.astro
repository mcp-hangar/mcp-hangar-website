---
import Button from "./Button.astro";
import Gate from "./icons/Gate.astro";
import { LINKS } from "../config";
---

<footer class="border-t border-zinc-800/50">
    <div class="max-w-6xl mx-auto px-6 py-16">
        <!-- Three cells, not four: dropping the Product column left the grid a
             column short, and a 4-column track with 3 things in it is a gap. -->
        <div class="grid grid-cols-2 md:grid-cols-3 gap-8 mb-12">
            <!-- Brand -->
            <div class="col-span-2 md:col-span-1">
                <div class="flex items-center gap-2 mb-4">
                    <Gate size={22} class="text-zinc-300" />
                    <span class="font-semibold text-zinc-100">mcp-hangar</span>
                </div>
                <p class="text-sm text-zinc-500 leading-relaxed mb-4">
                    Open-source MCP policy enforcement plane.
                </p>
                <!-- The shared button, not a fourth hand-rolled one. This was
                     zinc-950 text on a zinc-700 fill -- black on dark grey, about
                     2:1 -- and its hover state was the light fill the resting
                     state should have had. -->
                <Button href={LINKS.ossQuickstart} variant="secondary" size="sm">
                    Install
                </Button>
            </div>

            <!-- No Product column. It held one link, to the /#features anchor,
                 which is the reason the nav does not carry a Features tab either:
                 the nav names places, and "what it does" is the page you are
                 already on. A heading over a single anchor is not a place. -->
            <!-- Documentation -->
            <div>
                <h4 class="text-sm font-semibold text-zinc-300 mb-4">Documentation</h4>
                <ul class="space-y-2 text-sm">
                    <li><a href="/docs" class="text-zinc-500 hover:text-zinc-300 transition-colors duration-300">Documentation</a></li>
                    <li><a href="/learn" class="text-zinc-500 hover:text-zinc-300 transition-colors duration-300">Learn</a></li>
                    <li><a href="/docs/cookbook/index" class="text-zinc-500 hover:text-zinc-300 transition-colors duration-300">Cookbook</a></li>
                    <li><a href="/docs/reference/configuration" class="text-zinc-500 hover:text-zinc-300 transition-colors duration-300">Configuration</a></li>
                </ul>
            </div>

            <!-- Community -->
            <div>
                <h4 class="text-sm font-semibold text-zinc-300 mb-4">Community</h4>
                <ul class="space-y-2 text-sm">
                    <li><a href="/blog" class="text-zinc-500 hover:text-zinc-300 transition-colors duration-300">Blog</a></li>
                    <li><a href="https://github.com/mcp-hangar/mcp-hangar" target="_blank" rel="noopener noreferrer" class="text-zinc-500 hover:text-zinc-300 transition-colors duration-300">GitHub</a></li>
                    <li><a href="/docs/development/CONTRIBUTING" class="text-zinc-500 hover:text-zinc-300 transition-colors duration-300">Contributing</a></li>
                    <li><a href="/docs/changelog" class="text-zinc-500 hover:text-zinc-300 transition-colors duration-300">Changelog</a></li>
                    <!-- The security hub, not the raw docs policy page: it carries
                         the CVE ledger and the OWASP map, and links on to
                         /docs/security for the disclosure process. -->
                    <li><a href="/security" class="text-zinc-500 hover:text-zinc-300 transition-colors duration-300">Security</a></li>
                </ul>
            </div>
        </div>

        <div class="pt-8 border-t border-zinc-800/50 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-zinc-500">
            <span>&copy; 2026 MCP Hangar. Released under the MIT License.</span>
            <div class="flex items-center gap-4">
                <a href="/privacy" class="hover:text-zinc-400 transition-colors">Privacy Policy</a>
                <a href="/terms" class="hover:text-zinc-400 transition-colors">Terms</a>
            </div>
        </div>
    </div>
</footer>
