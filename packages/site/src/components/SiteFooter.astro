---
import Gate from "./icons/Gate.astro";
import { BRAND, CATEGORY, LINKS, VERSION_TAG } from "../config";

/**
 * Two columns of places and a colophon. The old footer headed a column
 * "Documentation" and then listed "Documentation" as its first link, and the
 * product's changelog was missing; both were in the audit (critique #10).
 */
const columns = [
    {
        heading: "Product",
        links: [
            { href: "/docs", label: "Docs" },
            { href: "/learn", label: "Learn" },
            { href: "/security", label: "Security" },
            { href: "/docs/adr", label: "Decisions" },
            { href: LINKS.changelog, label: "Changelog", external: true },
        ],
    },
    {
        heading: "Project",
        links: [
            { href: LINKS.github, label: "GitHub", external: true },
            { href: LINKS.pypi, label: "PyPI", external: true },
            { href: "/blog", label: "Blog" },
            { href: LINKS.contributing, label: "Contributing", external: true },
        ],
    },
];
---

<footer class="border-t border-rule">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-14">
        <div class="grid grid-cols-2 md:grid-cols-[2fr_1fr_1fr] gap-x-8 gap-y-10">
            <div class="col-span-2 md:col-span-1 max-w-sm">
                <a href="/" class="inline-flex items-center gap-2 mb-3">
                    <Gate size={22} class="text-ink" />
                    <span class="font-display font-extrabold tracking-tight text-ink">{BRAND}</span>
                </a>
                <p class="text-sm text-ink-2">{CATEGORY}.</p>
                <p class="mt-3 font-mono text-xs text-ink-3">core {VERSION_TAG} · MIT · self-hosted</p>
            </div>

            {columns.map((col) => (
                <nav aria-label={col.heading}>
                    <p class="font-mono text-xs font-medium uppercase tracking-[0.12em] text-ink-3 mb-3">{col.heading}</p>
                    <ul class="space-y-2 text-sm">
                        {col.links.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    class="text-ink-2 hover:text-ink underline-offset-4 hover:underline"
                                    {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                                >
                                    {link.label}
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>
            ))}
        </div>

        <div class="mt-12 pt-6 border-t border-rule flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-sm text-ink-3">
            <span>&copy; 2026 MCP Hangar. Released under the MIT License.</span>
            <div class="flex items-center gap-4">
                <a href="/privacy" class="hover:text-ink">Privacy</a>
                <a href="/terms" class="hover:text-ink">Terms</a>
            </div>
        </div>
    </div>
</footer>
