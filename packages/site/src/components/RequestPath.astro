---
/**
 * The frame around the request path: one spine, top to bottom, with the
 * stages a call meets slotted into it in order.
 *
 * It replaces a static SVG of the same path. The SVG had to carry every
 * caption at once, so it either shouted or went unreadable, and the
 * explanations lived in a prose section further down the page — a reader had
 * to hold the picture in their head while scrolling to the words.
 *
 * Visually it is the Learn hub's architecture map: same tokens, same panel,
 * same neutral accent. The hub declares those custom properties on
 * `.learn-hub`, which does not wrap a Learn *entry*, so they are declared
 * again here rather than inherited — one map, drawn twice, should not look
 * like two products.
 *
 * The spine is a single line the stages sit on, because the claim the page is
 * making is that there is exactly one path. Anything drawn off to the side
 * would be arguing against the page.
 */
interface Props {
    /** The line under the flow — what is true of every stage above it. */
    note?: string;
    class?: string;
}

const { note, class: className = "" } = Astro.props;
---

<div class={`rp ${className}`}>
    <ol class="rp-flow">
        <slot />
    </ol>
    {note && <p class="rp-note">{note}</p>}
</div>

<style>
    /* The Learn hub's palette, verbatim. */
    .rp {
        --panel: #18181b;
        --panel-2: #1b1b1f;
        --raise: #27272a;
        --ink: #fafafa;
        --ink-2: #d4d4d8;
        --muted: #a1a1aa;
        --faint: #71717a;
        --line: #27272a;
        --line-2: #3f3f46;
        --brand: #d4d4d8;
        --brand-dim: #27272a;
        --r: 14px;

        margin: 2rem 0;
        background: radial-gradient(120% 120% at 50% 0, var(--panel-2), var(--panel));
        border: 1px solid var(--line);
        border-radius: var(--r);
        padding: 18px 18px 20px;
    }

    .rp-flow {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
        position: relative;
    }

    /* The spine. One line, behind the cards — it is the page's whole argument,
       so it is drawn once and never breaks. 27px = card padding (16px) + half
       a 22px ordinal, so the seam's ordinals sit on it. */
    .rp-flow::before {
        content: "";
        position: absolute;
        left: 26px;
        top: 18px;
        bottom: 18px;
        width: 2px;
        border-radius: 2px;
        background: linear-gradient(
            180deg,
            transparent,
            var(--line-2) 6%,
            var(--line-2) 94%,
            transparent
        );
    }

    .rp-note {
        margin: 12px 0 0;
        font-size: 12.5px;
        line-height: 1.6;
        color: var(--faint);
        text-align: center;
        text-wrap: balance;
    }
</style>
