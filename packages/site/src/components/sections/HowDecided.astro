---
import PolicySnippet from "../PolicySnippet.astro";
import Record from "../Record.astro";
import { AFTER_GATES, CORE, GATES } from "../../lib/gate-path";
import { PATH_RECORD } from "../../lib/home-records";
import { TOOL_ACCESS_SNIPPET } from "../../lib/home-snippets";

/**
 * How a call is decided: the whole path, in core's order, read from core.
 *
 * The list is generated (lib/gate-path.ts over src/data/core.json), so it is
 * every gate the batch executor runs at the advertised version -- including
 * the ones the old a-to-i strip left out: the tenant budget, the timeout, the
 * routing. The stages after it are labelled apart because core says they are
 * not gates. The section ends with what one small config produces.
 */
const n = GATES.length;
---

<section id="how-a-call-is-decided" class="border-t border-rule scroll-mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 md:py-24">
    <header class="max-w-2xl mb-10">
      <p class="font-mono text-xs text-ink-3 mb-3">01 · the path</p>
      <h2 class="text-h2 text-ink mb-4">How a call is decided</h2>
      <p class="text-lead text-ink-2">
        A tool call passes {n} gates, in an order core fixes, before it reaches your server. The first one
        that says no is the verdict. Nothing on the verdict path is scored or learned.
      </p>
    </header>

    <div class="grid gap-10 lg:grid-cols-[1.15fr_1fr] lg:gap-14 [&>*]:min-w-0">
      <div>
        <ol class="gate-list" aria-label={`The ${n} gates, in order`}>
          {GATES.map((g, i) => (
            <li class:list={["gate", g.kind]}>
              <span class="gate-n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <span class="gate-body">
                <span class="gate-name">
                  {g.label}
                  {g.kind === "machinery" && <span class="gate-kind">runtime</span>}
                </span>
                <span class="gate-asks">{g.asks}</span>
              </span>
              <code class="gate-codes">{g.codes.join(" · ")}</code>
            </li>
          ))}
        </ol>

        <p class="mt-8 mb-3 font-mono text-xs text-ink-3">then, and not gates</p>
        <ul class="gate-list">
          {AFTER_GATES.map((s) => (
            <li class="gate after">
              <span class="gate-n" aria-hidden="true">·</span>
              <span class="gate-body">
                <span class="gate-name">{s.label}</span>
                <span class="gate-asks">{s.asks}</span>
              </span>
              <code class="gate-codes">{s.codes.join(" · ")}</code>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-sm text-ink-3">
          Generated from <code class="font-mono">_GATES</code> in core {CORE.tag}. The path with the cluster plane around it is on{" "}
          <a
            href="/learn/the-request-path"
            class="text-ink-2 underline underline-offset-4 decoration-rule-strong hover:decoration-ink">the request path</a
          >.
        </p>
      </div>

      <div class="lg:sticky lg:top-24 self-start space-y-6">
        <div>
          <p class="font-mono text-xs text-ink-3 mb-3">this config</p>
          <PolicySnippet filename="config.yaml" code={TOOL_ACCESS_SNIPPET} />
        </div>
        <div>
          <p class="font-mono text-xs text-ink-3 mb-3">produces this record</p>
          <Record rows={PATH_RECORD} label="What the config above decides, call by call">
            Reads pass, the write waits for a person, anything else is never exposed, and a tenant over its
            rate is refused before anyone is asked.
          </Record>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .gate-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--c-rule);
  }
  .gate {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--c-rule);
  }
  .gate-n {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--c-ink-3);
  }
  .gate-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .gate-name {
    font-weight: 600;
    color: var(--c-ink);
  }
  .gate.machinery .gate-name {
    font-weight: 400;
    color: var(--c-ink-2);
  }
  .gate-kind {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--c-ink-3);
    border: 1px solid var(--c-rule);
    border-radius: 2px;
    padding: 0 0.3rem;
  }
  .gate-asks {
    font-size: 0.875rem;
    color: var(--c-ink-3);
  }
  .gate-codes {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--c-ink-2);
    text-align: right;
    overflow-wrap: anywhere;
    max-width: 16rem;
  }
  @media (max-width: 40rem) {
    .gate {
      grid-template-columns: 1.75rem minmax(0, 1fr);
    }
    .gate-codes {
      grid-column: 2;
      text-align: left;
      max-width: none;
    }
  }
</style>
