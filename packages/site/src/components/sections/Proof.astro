---
import { CORE } from "../../lib/gate-path";
import core from "../../data/core.json";

/**
 * What you can prove afterwards, ending in the record a SIEM actually gets.
 *
 * The two lines below are not typed here: scripts/core-data.py runs the
 * advertised core's own audit handler and exporters on one `ToolCallRefused`
 * and stores what they write (src/data/core.json). The refusal is the
 * delete_repository call from the record one section up.
 */
const { leef, jsonl } = core.record;
---

<section class="border-t border-rule">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 md:py-24">
    <header class="max-w-2xl mb-10">
      <p class="font-mono text-xs text-ink-3 mb-3">02 · the record</p>
      <h2 class="text-h2 text-ink mb-4">What you can prove afterwards</h2>
      <p class="text-lead text-ink-2">
        Every call is written down with the caller attached — allowed and denied alike. A verdict nobody can
        attribute proves nothing, so identity travels with the record rather than being reconstructed
        afterwards.
      </p>
    </header>

    <dl class="grid gap-x-10 gap-y-6 sm:grid-cols-3 mb-12 max-w-5xl">
      <div class="border-t border-rule pt-4">
        <dt class="font-semibold text-ink mb-1">Audit trail</dt>
        <dd class="text-sm text-ink-3">
          Each allow, deny and hold, with the caller, the tenant, the gate and the bounded reason. Codes only,
          never the text a gate was handed.
        </dd>
      </div>
      <div class="border-t border-rule pt-4">
        <dt class="font-semibold text-ink mb-1">SIEM export</dt>
        <dd class="text-sm text-ink-3">
          CEF, LEEF 2.0, JSON lines and RFC 5424 syslog, the same refusal fields in all four.
        </dd>
      </div>
      <div class="border-t border-rule pt-4">
        <dt class="font-semibold text-ink mb-1">Traces</dt>
        <dd class="text-sm text-ink-3">
          OTLP spans per call, a <code class="font-mono">hangar.gate.decision</code> event per gate, and{" "}
          <code class="font-mono">hangar.refusal.gate</code> on the call that stopped.
        </dd>
      </div>
    </dl>

    <figure class="min-w-0 max-w-5xl">
      <p class="font-mono text-xs text-ink-3 mb-3">the refused delete_repository, as your SIEM receives it</p>
      <div class="export" tabindex="0" role="region" aria-label="One refusal, exported as LEEF 2.0 and as JSON lines">
        <p class="export-label">LEEF 2.0</p>
        <pre><code>{leef}</code></pre>
        <p class="export-label">JSON lines</p>
        <pre><code>{jsonl}</code></pre>
      </div>
      <figcaption class="mt-3 text-sm text-ink-3">
        Written by core {CORE.tag}'s own audit handler and exporters from one <code class="font-mono"
          >ToolCallRefused</code
        > event, not typed for this page.{" "}
        <a
          href="/docs/reference/configuration"
          class="text-ink-2 underline underline-offset-4 decoration-rule-strong hover:decoration-ink"
          >Configure the exporters</a
        >.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .export {
    background: var(--c-panel);
    border: 1px solid var(--c-rule);
    border-radius: 6px;
    overflow-x: auto;
  }
  .export:focus-visible {
    outline: 2px solid var(--c-ink);
    outline-offset: 2px;
  }
  .export-label {
    margin: 0;
    padding: 0.4rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-ink-3);
    background: var(--c-subtle);
    border-bottom: 1px solid var(--c-rule);
  }
  .export-label + pre + .export-label {
    border-top: 1px solid var(--c-rule);
  }
  pre {
    margin: 0;
    padding: 0.8rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--c-ink);
    tab-size: 2;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
