---
import Badge from "../Badge.astro";
import Button from "../Button.astro";
import GithubIcon from "../icons/GithubIcon.astro";
import PolicySnippet from "../PolicySnippet.astro";
import WireRecord from "../WireRecord.astro";
import {
  HEADLINE,
  HERO_SUB,
  LINKS,
  TIME_TO_VALUE,
  VERSION_TAG,
} from "../../config";

/**
 * The hero orients; it does not argue. One word carries the whole page —
 * *verdict* — and it is the same word the design system is built on (allow is
 * green, deny is rose, nothing else gets a hue) and the same word the proof
 * block below produces on the wire. Say it in the h1 and the page has a spine.
 *
 * The ecosystem thesis that used to sit here is not gone, it is demoted one
 * section: it opens "Why enforcement, not detection", where it justifies a
 * category to someone who already knows what they are looking at. A reader who
 * has not been told what this is yet cannot be argued with.
 *
 * The subhead is the product's one self-description (HERO_SUB in config.ts,
 * shared with the meta, JSON-LD, llms.txt and the footer): the category, what
 * it governs, then where it runs. Kubernetes is one of three places, not the
 * premise -- core is a Python package, and the operator is one deployment path.
 *
 * It says "Hangar", not "MCP Hangar": MCP appears once per sentence at most,
 * and the wordmark sits in the nav thirty pixels above. The brand is already
 * on screen; repeating it costs a word and buys nothing.
 *
 * Under it sits the proof rather than a screenshot of a dashboard: a policy,
 * a call, and the verdict as the wire carries it. Then the same verdict on a
 * laptop -- a recording of a real run, not a transcript composed to look like
 * one, because the page's whole claim is that the verdict is reproducible.
 */
const policy = `apiVersion: mcp-hangar.io/v1alpha2
kind: MCPEgressPolicy
metadata:
  name: gh-readonly
spec:
  mode: Enforce
  targetRef:
    kind: MCPServer
    name: github
  defaultAction: Deny
  upstreams:
    - name: github
      match:
        host: api.github.com
      tools:
        allow: ["get_*", "list_*"]`;
---

<section class="max-w-6xl mx-auto px-6 pt-16 pb-24">
  <div class="max-w-3xl mx-auto text-center">
    <Badge class="animate-fade-in mb-8">{VERSION_TAG} — Open Source — MIT License</Badge>

    <h1 class="animate-slide-up text-5xl md:text-6xl font-bold tracking-tight leading-[1.05] mb-6 text-balance">
      {HEADLINE}
    </h1>

    <p class="text-xl md:text-2xl text-ink-2 mb-5 text-balance">
      {HERO_SUB}
    </p>

    <p class="text-lg text-ink-3 max-w-xl mx-auto mb-10">
      Deterministic — no ML. Self-hosted — no SaaS. MIT.
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <Button href={LINKS.ossQuickstart} variant="primary" withArrow>
        Install {VERSION_TAG}
      </Button>
      <Button href={LINKS.github} variant="secondary" external>
        <GithubIcon /> GitHub
      </Button>
    </div>
  </div>

  <!-- The proof, not an illustration of it. -->
  <div class="max-w-3xl mx-auto mt-14">
    <p class="font-mono text-xs font-semibold text-ink-3 uppercase tracking-[0.16em] text-center mb-5">
      A call denied on purpose
    </p>
    <div class="grid gap-4">
      <PolicySnippet filename="gh-readonly.yaml" code={policy} />
      <WireRecord
        time="12:04:41"
        caller="team-research@corp"
        method="tools/call"
        target="github.create_issue"
        verdict="deny"
        code="isError: true"
      />
    </div>
    <p class="text-sm text-ink-3 text-center mt-5">
      The policy allows two read patterns, so the write is refused before it reaches GitHub —
      and the refusal is recorded against the caller who made it.
    </p>
  </div>

  <!-- The same mechanism with nothing to install but a wheel. The cluster proof
       above is the product at scale; this is the one a reader can reproduce in
       the next TIME_TO_VALUE, which is a different and equally load-bearing
       claim. -->
  <div class="max-w-3xl mx-auto mt-12">
    <p class="font-mono text-xs font-semibold text-ink-3 uppercase tracking-[0.16em] text-center mb-5">
      The same verdict, on a laptop
    </p>
    <figure class="deny-recording rounded-lg border border-rule overflow-hidden bg-ground">
      <img
        class="motion"
        src="/demo/governed-deny.gif"
        alt="A terminal: a pinned tool call answers ALLOWED, the server rewrites its tool's description, and the identical call comes back DENIED — Tool 'echo' schema does not match its pinned digest."
        width="1160"
        height="300"
      />
      <img
        class="still"
        src="/demo/governed-deny.png"
        alt="The same terminal transcript, as a still: the pinned call is allowed, the description changes, the identical call is denied against its pinned digest."
        width="1160"
        height="300"
      />
    </figure>
    <p class="text-sm text-ink-3 text-center mt-5">
      No cluster, no operator. A pin is the fingerprint of the tool you approved; when the
      description changes, the call stops —
      <a href="/learn/from-install-to-a-governed-deny-locally" class="text-ink-3 underline underline-offset-4 hover:text-ink">
        {TIME_TO_VALUE.words}, start to refusal
      </a>.
    </p>
  </div>
</section>

<style>
  /* The recording runs 20 seconds and loops, which is exactly the moving
     content WCAG 2.2.2 is about. A reader who has asked for reduced motion
     gets the last frame instead -- and loses nothing, because the last frame
     holds the whole transcript. */
  .deny-recording img {
    display: block;
    width: 100%;
    height: auto;
  }

  .deny-recording .still {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .deny-recording .motion {
      display: none;
    }

    .deny-recording .still {
      display: block;
    }
  }
</style>
