---
import { getCollection } from "astro:content";
import CopyCommand from "../CopyCommand.astro";
import BookOpenIcon from "../icons/BookOpenIcon.astro";
import FileTextIcon from "../icons/FileTextIcon.astro";
import { countCookbookRecipes } from "../../docsNav";
import { INSTALL_COMMAND } from "../../config";

/**
 * Three equal boxes implied three equal choices. Installing is the one thing most
 * readers came for, so it gets the weight and the other two sit beside it.
 */
const recipeCount = countCookbookRecipes(await getCollection("oss"));
const learnCount = (await getCollection("learn")).filter(e => !e.data.draft).length;
import SectionHeader from "../SectionHeader.astro";
---

<section class="max-w-6xl mx-auto px-6 pb-24">
    <SectionHeader>
        Install it, understand it, or look it up
        <p slot="lead">
            Where to go next, depending on why you came.
        </p>
    </SectionHeader>

    <div class="grid grid-cols-1 md:grid-cols-[1.25fr_1fr] gap-5">
        <!-- Primary: install -->
        <div class="rounded-3xl bg-subtle border border-rule-strong p-8 md:p-10 flex flex-col">
            <span class="font-mono text-sm font-semibold text-ink-2 uppercase tracking-[0.16em] mb-4">
                Start
            </span>
            <h3 class="text-2xl font-bold text-ink mb-3">Run it against your own servers</h3>
            <p class="text-lg text-ink-3 mb-7">
                Install the Python core, put a policy in front of one MCP server, and watch
                a call get denied on purpose.
            </p>

            <CopyCommand
                command={INSTALL_COMMAND}
                label="Copy pip install command to clipboard"
                class="w-full mb-6"
            />

            <a
                href="/docs/getting-started/quickstart"
                class="mt-auto inline-flex items-center justify-center gap-2 px-6 py-4 bg-ink hover:bg-ink-2 text-ground font-semibold text-lg rounded-xl transition-colors"
            >
                Quickstart
                <span aria-hidden="true">&rarr;</span>
            </a>
        </div>

        <!-- Secondary: learn + docs -->
        <div class="grid grid-rows-2 gap-5">
            <a
                href="/learn"
                class="group rounded-3xl bg-panel border border-rule hover:border-rule-strong hover:bg-panel p-7 transition-all duration-300 flex flex-col"
            >
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-11 h-11 rounded-xl bg-subtle border border-rule-strong flex items-center justify-center text-ink-2 shrink-0">
                        <BookOpenIcon />
                    </div>
                    <h3 class="text-xl font-semibold text-ink group-hover:text-ink transition-colors">Learn</h3>
                    <span class="ml-auto font-mono text-sm text-ink-3">{learnCount}</span>
                </div>
                <p class="text-base text-ink-3 leading-relaxed">
                    Explainers and walkthroughs: what an enforcement plane is, how a request
                    travels it, and where it stops.
                </p>
                <span class="mt-auto pt-5 inline-flex items-center gap-2 text-base font-semibold text-ink-2">
                    Start with the request path
                    <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">&rarr;</span>
                </span>
            </a>

            <a
                href="/docs"
                class="group rounded-3xl bg-panel border border-rule hover:border-rule-strong hover:bg-panel p-7 transition-all duration-300 flex flex-col"
            >
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-11 h-11 rounded-xl bg-subtle border border-rule flex items-center justify-center text-ink-3 shrink-0">
                        <FileTextIcon />
                    </div>
                    <h3 class="text-xl font-semibold text-ink group-hover:text-ink transition-colors">Docs</h3>
                    <span class="ml-auto font-mono text-sm text-ink-3">{recipeCount}</span>
                </div>
                <p class="text-base text-ink-3 leading-relaxed">
                    Production recipes, plus configuration, CLI, REST API and MCP tool
                    reference.
                </p>
                <span class="mt-auto pt-5 inline-flex items-center gap-2 text-base font-semibold text-ink-2">
                    Open the cookbook
                    <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">&rarr;</span>
                </span>
            </a>
        </div>
    </div>
</section>
