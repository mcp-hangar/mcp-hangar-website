---
import PipelineMotif from "../PipelineMotif.astro";

/**
 * Two things, in order: where Hangar sits, then what a call meets once it is
 * there. The gate list used to be written out by hand here, which meant the
 * homepage and the Learn diagram could drift; it comes from PipelineMotif now,
 * so there is one list of gates on the site.
 */
---

<section class="max-w-6xl mx-auto px-6 pb-32">
    <div class="max-w-3xl mx-auto text-center mb-14">
        <span class="font-mono text-sm font-semibold text-zinc-500 uppercase tracking-[0.16em]">
            How it works
        </span>
        <h2 class="text-4xl font-bold tracking-tight text-zinc-100 mt-4 mb-5 text-balance">
            One proxy between your agents and your MCP servers
        </h2>
        <p class="text-xl text-zinc-400">
            Every call arrives on the same path and meets the same gates, in the same
            order, whatever the agent and whatever the backend.
        </p>
    </div>

    <div class="rounded-3xl bg-zinc-900/30 border border-zinc-800/50 p-6 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center gap-5">
            <div class="md:flex-1">
                <div class="rounded-2xl bg-zinc-800/30 border border-zinc-700/40 p-6 text-center">
                    <span class="block text-lg font-semibold text-zinc-100">AI agents</span>
                    <span class="block text-sm text-zinc-400 mt-1.5">Claude, GPT, custom</span>
                </div>
            </div>

            <div class="hidden md:flex flex-col items-center gap-2 px-1">
                <span class="font-mono text-xs text-zinc-500 tracking-wider">MCP</span>
                <div class="w-14 h-px bg-zinc-700"></div>
            </div>
            <div class="md:hidden flex flex-col items-center gap-1.5">
                <div class="w-px h-6 bg-zinc-700"></div>
                <span class="font-mono text-xs text-zinc-500 tracking-wider">MCP</span>
            </div>

            <div class="md:flex-[1.2]">
                <div class="rounded-2xl bg-zinc-100/[0.04] border border-zinc-600/50 p-6 text-center">
                    <span class="block text-lg font-semibold text-zinc-50">Hangar</span>
                    <span class="block font-mono text-xs text-zinc-500 uppercase tracking-wider mt-1.5">
                        one deterministic path
                    </span>
                </div>
            </div>

            <div class="hidden md:flex flex-col items-center gap-2 px-1">
                <span class="font-mono text-xs text-zinc-500 tracking-wider">MCP</span>
                <div class="w-14 h-px bg-zinc-700"></div>
            </div>
            <div class="md:hidden flex flex-col items-center gap-1.5">
                <div class="w-px h-6 bg-zinc-700"></div>
                <span class="font-mono text-xs text-zinc-500 tracking-wider">MCP</span>
            </div>

            <div class="md:flex-1">
                <div class="rounded-2xl bg-zinc-800/30 border border-zinc-700/40 p-6 text-center">
                    <span class="block text-lg font-semibold text-zinc-100">MCP servers</span>
                    <span class="block text-sm text-zinc-400 mt-1.5">Databases, APIs, tools</span>
                </div>
            </div>
        </div>

        <div class="mt-9 pt-7 border-t border-zinc-800/50">
            <p class="font-mono text-xs font-semibold text-zinc-500 uppercase tracking-[0.16em] mb-4 text-center">
                What a call meets inside, in order
            </p>
            <PipelineMotif size="compact" />
        </div>

        <div class="mt-7 pt-5 border-t border-zinc-800/50 text-center">
            <a
                href="/learn/the-request-path"
                class="group inline-flex items-center gap-2 text-base font-semibold text-zinc-300 hover:text-zinc-100 transition-colors"
            >
                Follow a single call through every gate
                <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">&rarr;</span>
            </a>
        </div>
    </div>
</section>
