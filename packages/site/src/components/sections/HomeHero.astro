---
import Button from "../Button.astro";
import CopyCommand from "../CopyCommand.astro";
import { HEADLINE, HERO_SUB, INSTALL_COMMAND, VERSION_TAG } from "../../config";
---

<section class="max-w-6xl mx-auto px-4 sm:px-6 pt-12 md:pt-20 pb-16 md:pb-24">
  <div class="grid gap-10 lg:grid-cols-[1.05fr_1fr] lg:gap-14 lg:items-center [&>*]:min-w-0">
    <div>
      <p class="font-mono text-xs text-ink-3 mb-5">Open-source MCP gateway · {VERSION_TAG} · MIT</p>
      <h1 class="text-display font-display text-ink mb-6">{HEADLINE}</h1>
      <p class="text-lead text-ink-2 max-w-[38rem] mb-4">{HERO_SUB}</p>
      <p class="text-sm text-ink-3 mb-8">Deterministic — no ML. Self-hosted — no SaaS.</p>
      <div class="flex flex-wrap items-center gap-3">
        <CopyCommand command={INSTALL_COMMAND} label="Copy pip install command to clipboard" />
        <Button href="#how-a-call-is-decided" variant="secondary">Read a verdict</Button>
      </div>
    </div>

    <figure class="border border-rule bg-panel rounded-sm p-5 sm:p-8">
      <p class="font-mono text-xs text-ink-3">Where Hangar sits</p>
      <div class="grid grid-cols-[minmax(0,1fr)_1.25rem_minmax(0,1.15fr)_1.25rem_minmax(0,1fr)] items-center py-10 text-center">
        <div class="border border-rule-strong bg-ground rounded-sm px-1 py-5 sm:px-2">
          <p class="font-semibold text-xs sm:text-sm text-ink">MCP client</p>
          <p class="text-xs text-ink-3 mt-1">Requests tools</p>
        </div>
        <span class="text-ink-3" aria-hidden="true">&rarr;</span>
        <div class="border-2 border-ink bg-ground rounded-sm px-1 py-6 sm:px-2">
          <p class="font-display font-extrabold text-sm sm:text-base text-ink">MCP Hangar</p>
          <p class="text-xs text-ink-2 mt-1">Checks policy</p>
        </div>
        <span class="text-ink-3" aria-hidden="true">&rarr;</span>
        <div class="border border-rule-strong bg-ground rounded-sm px-1 py-5 sm:px-2">
          <p class="font-semibold text-xs sm:text-sm text-ink">MCP server</p>
          <p class="text-xs text-ink-3 mt-1">Runs tools</p>
        </div>
      </div>
      <figcaption class="text-sm text-ink-2 border-t border-rule pt-4">
        Tool calls pass through Hangar; calls allowed by policy can reach the server.
      </figcaption>
    </figure>
  </div>
</section>
