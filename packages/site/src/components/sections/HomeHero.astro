---
import Button from "../Button.astro";
import CopyCommand from "../CopyCommand.astro";
import { HEADLINE, HERO_SUB, INSTALL_COMMAND, VERSION_TAG } from "../../config";
---

<section class="max-w-6xl mx-auto px-4 sm:px-6 pt-12 md:pt-20 pb-16 md:pb-24">
  <div class="grid gap-10 lg:grid-cols-[1.05fr_1fr] lg:gap-14 lg:items-center [&>*]:min-w-0">
    <div>
      <p class="font-mono text-xs text-ink-3 mb-5">Open-source MCP gateway · {VERSION_TAG} · MIT</p>
      <h1 class="text-display font-display text-ink mb-6">{HEADLINE}</h1>
      <p class="text-lead text-ink-2 max-w-[38rem] mb-4">{HERO_SUB}</p>
      <p class="text-sm text-ink-3 mb-8">Deterministic — no ML. Self-hosted — no SaaS.</p>
      <div class="flex flex-wrap items-center gap-3">
        <CopyCommand command={INSTALL_COMMAND} label="Copy pip install command to clipboard" />
        <Button href="#how-a-call-is-decided" variant="secondary">Read a verdict</Button>
      </div>
    </div>

    <div class="border border-rule bg-panel rounded-sm p-5 sm:p-8">
      <p class="font-mono text-xs text-ink-3 mb-6">Where Hangar sits</p>
      <ol aria-label="A tool call's path" class="space-y-0">
        <li class="grid grid-cols-[2rem_1fr] gap-3">
          <span class="font-mono text-xs text-ink-3 pt-1" aria-hidden="true">01</span>
          <div class="border-l border-rule-strong pl-5 pb-6">
            <p class="font-semibold text-ink">MCP client</p>
            <p class="text-sm text-ink-3 mt-1">Requests a tool call</p>
          </div>
        </li>
        <li class="grid grid-cols-[2rem_1fr] gap-3">
          <span class="font-mono text-xs text-ink-3 pt-1" aria-hidden="true">02</span>
          <div class="border-l-2 border-ink pl-5 pb-6">
            <p class="font-display font-extrabold text-xl text-ink">MCP Hangar</p>
            <p class="text-sm text-ink-2 mt-1">Checks the call against your policy and records the decision.</p>
          </div>
        </li>
        <li class="grid grid-cols-[2rem_1fr] gap-3">
          <span class="font-mono text-xs text-ink-3 pt-1" aria-hidden="true">03</span>
          <div class="border-l border-rule-strong pl-5">
            <p class="font-semibold text-ink">MCP server</p>
            <p class="text-sm text-ink-3 mt-1">Receives calls that are allowed to proceed</p>
          </div>
        </li>
      </ol>
    </div>
  </div>
</section>
