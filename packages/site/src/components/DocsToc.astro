---
import type { MarkdownHeading } from "astro";

/**
 * "On this page" — the second and third level of a documentation page.
 *
 * It appears from `xl` up, where the article column has stopped growing and
 * the space to its right is otherwise empty. Below that width there is nowhere
 * to put it that would not push the article down, and the sidebar drawer
 * already carries navigation.
 *
 * h1 is excluded: the page renders exactly one, from frontmatter, and it is
 * the page title the reader just read. h4 and deeper are excluded because a
 * rail that mirrors the whole document is a second document.
 */
interface Props {
    headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length > 1 && (
    <nav
        class="hidden xl:block w-56 shrink-0 sticky top-24 self-start max-h-[calc(100vh-8rem)] overflow-y-auto docs-toc"
        aria-labelledby="toc-heading"
    >
        <p
            id="toc-heading"
            class="font-mono text-xs font-semibold text-zinc-500 uppercase tracking-[0.16em] mb-3"
        >
            On this page
        </p>
        <ul class="space-y-1 text-sm border-l border-zinc-800">
            {items.map((h) => (
                <li>
                    <a
                        href={`#${h.slug}`}
                        class:list={[
                            "block border-l -ml-px py-1 text-zinc-500 hover:text-zinc-200 hover:border-zinc-500 border-transparent transition-colors",
                            h.depth === 3 ? "pl-6" : "pl-3",
                        ]}
                    >
                        {h.text}
                    </a>
                </li>
            ))}
        </ul>
    </nav>
)}
