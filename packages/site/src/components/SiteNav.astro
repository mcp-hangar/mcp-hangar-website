---
import Gate from "./icons/Gate.astro";
import { BRAND, LINKS } from "../config";

// Cilium and OPA Gatekeeper do not have a Features tab, and neither do we: the
// nav names places, and "what it does" is the page you are already on. There is
// no /features route to redirect — it was only ever the /#features anchor, which
// the footer still carries.
// Slash-less, like every canonical and og:url on the site: vercel.json sets
// `trailingSlash: false`, so the slashed form is a 308 the visitor pays for.
// This nav renders twice per page, so it was the biggest source of them.
const navLinks = [
  { href: "/docs", label: "Docs" },
  { href: "/learn", label: "Learn" },
  { href: "/security", label: "Security" },
  { href: "/blog", label: "Blog" },
  // A page, not a modal: static Pagefind results, reachable without JS.
  { href: "/search", label: "Search" },
  { href: LINKS.github, label: "GitHub", external: true },
];

// The section the reader is in, marked for assistive tech and drawn as an
// underline: the nav names places, so it should say which one this is.
const here = Astro.url.pathname;
const isCurrent = (href: string) =>
  href.startsWith("/") && (here === href || here.startsWith(`${href}/`));
---

<header class="sticky top-0 z-50 bg-ground/95 backdrop-blur-sm border-b border-rule">
  <nav
    class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between"
    aria-label="Main navigation"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 shrink-0">
      <Gate size={24} class="text-ink-2" />
      <span class="font-display font-extrabold tracking-tight text-ink text-base">{BRAND}</span>
    </a>

    <div class="flex items-center gap-1">
    <!-- Desktop links -->
    <div class="hidden md:flex items-center gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isCurrent(link.href) ? "page" : undefined}
          class="nav-link px-3 py-2 text-sm text-ink-2 hover:text-ink transition-colors duration-150"
          {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
        >
          {link.label}
        </a>
      ))}
      <div class="w-px h-5 bg-rule mx-2" />
      <a
        href={LINKS.ossQuickstart}
        class="ml-1 inline-flex items-center px-3 py-1.5 text-sm bg-ink hover:bg-ink-2 text-ground font-semibold rounded-[4px] transition-colors duration-150"
      >
        Get Started
      </a>
    </div>

    <!-- Theme. Hidden until the script below can run it: without JS the page
         follows the system, and a button that does nothing is worse than none.
         Its name says what it will do, not what the page is now. -->
    <button
      id="theme-toggle"
      type="button"
      hidden
      class="p-2 md:ml-2 text-ink-3 hover:text-ink rounded-md hover:bg-subtle transition-colors"
      aria-label="Switch to dark theme"
    >
      <svg id="theme-icon-dark" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
      </svg>
      <svg id="theme-icon-light" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4" stroke-width="1.75" />
        <path stroke-linecap="round" stroke-width="1.75" d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
      </svg>
    </button>

    <!-- Mobile hamburger -->
    <button
      id="nav-mobile-toggle"
      class="md:hidden p-2 -mr-2 text-ink-3 hover:text-ink transition-colors"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <svg class="w-5 h-5" id="nav-icon-open" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg class="w-5 h-5 hidden" id="nav-icon-close" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="nav-mobile-menu" class="hidden md:hidden border-t border-rule">
    <div class="px-4 py-4 space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block px-3 py-2.5 text-sm text-ink-2 hover:text-ink hover:bg-subtle rounded-md transition-colors"
          {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
        >
          {link.label}
        </a>
      ))}
      <div class="pt-2">
        <a
          href={LINKS.ossQuickstart}
          class="block text-center px-3 py-2.5 text-sm bg-ink hover:bg-ink-2 text-ground font-semibold rounded-[4px] transition-colors"
        >
          Get Started
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .nav-link[aria-current="page"] {
    color: var(--c-ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.6em;
  }
</style>

<script>
  // The theme the page shows now: the reader's choice if they made one,
  // otherwise the system's.
  const root = document.documentElement;
  const media = matchMedia("(prefers-color-scheme: dark)");
  const current = () =>
    root.dataset.theme === "dark" || root.dataset.theme === "light"
      ? root.dataset.theme
      : media.matches
        ? "dark"
        : "light";
  const themeButton = document.getElementById("theme-toggle");
  const label = () => {
    const now = current();
    themeButton?.setAttribute("aria-label", now === "dark" ? "Switch to light theme" : "Switch to dark theme");
    document.getElementById("theme-icon-dark")?.classList.toggle("hidden", now === "dark");
    document.getElementById("theme-icon-light")?.classList.toggle("hidden", now !== "dark");
  };
  if (themeButton) {
    themeButton.hidden = false;
    label();
    media.addEventListener("change", label);
    themeButton.addEventListener("click", () => {
      const next = current() === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {
        // Not remembered, still applied.
      }
      label();
      document.dispatchEvent(new CustomEvent("themechange", { detail: next }));
    });
  }

  const toggle = document.getElementById('nav-mobile-toggle');
  const menu = document.getElementById('nav-mobile-menu');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle?.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
