---
import ArrowIcon from "./icons/ArrowIcon.astro";

type ButtonVariant = "primary" | "secondary" | "ghost";
type ButtonSize = "sm" | "md" | "lg";

interface Props {
    href: string;
    variant?: ButtonVariant;
    size?: ButtonSize;
    withArrow?: boolean;
    class?: string;
    external?: boolean;
}

const {
    href,
    variant = "secondary",
    size = "md",
    withArrow = false,
    class: className = "",
    external = false,
} = Astro.props;

// Square-shouldered and flat, like the record it sits beside: ink on paper.
// Primary is filled with ink, secondary is outlined in it, ghost is text.
const variantClasses: Record<ButtonVariant, string> = {
    primary:   "bg-ink text-ground border border-ink hover:bg-ink-2 hover:border-ink-2",
    secondary: "bg-transparent text-ink border border-ink hover:bg-subtle",
    ghost:     "bg-transparent text-ink-2 border border-transparent underline underline-offset-4 decoration-rule-strong hover:text-ink hover:decoration-ink",
};

const sizeClasses: Record<ButtonSize, string> = {
    sm: "px-3 py-1.5 text-sm",
    md: "px-4 py-2.5 text-base",
    lg: "px-5 py-3 text-base",
};

const base = "group inline-flex items-center gap-2 font-semibold rounded-[4px] transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink";
const classes = `${base} ${variantClasses[variant]} ${sizeClasses[size]} ${className}`;
---

{external ? (
    <a href={href} class={classes} target="_blank" rel="noopener noreferrer">
        <slot />
        {withArrow && (
            <span class="transition-transform duration-150 group-hover:translate-x-0.5 flex items-center justify-center">
                <ArrowIcon />
            </span>
        )}
    </a>
) : (
    <a href={href} class={classes}>
        <slot />
        {withArrow && (
            <span class="transition-transform duration-150 group-hover:translate-x-0.5 flex items-center justify-center">
                <ArrowIcon />
            </span>
        )}
    </a>
)}
