---
/**
 * The `accentColor` prop offered a choice between two hues that no longer
 * exist: after the verdict palette landed, both branches resolved to the same
 * zinc, so the prop was a switch with one position. Colour on a feature card
 * would mean nothing anyway — only verdicts and opt-in states carry a hue.
 *
 * Currently unused; kept because the card shape is still the site's, and it is
 * the obvious base if a neutral card is needed again.
 */
interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
---

<div class="group p-6 rounded-2xl bg-zinc-900/30 border border-zinc-800/50 hover:border-zinc-700/50 hover:bg-zinc-900/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-zinc-800/20">
    <div class="w-10 h-10 rounded-xl bg-zinc-800/40 border border-zinc-700/50 flex items-center justify-center text-zinc-300 mb-4 group-hover:scale-110 group-hover:bg-zinc-700/50 transition-all duration-300">
        <slot name="icon" />
    </div>
    <h3 class="font-semibold text-zinc-100 mb-2 group-hover:text-zinc-50 transition-colors duration-300">
        {title}
    </h3>
    <p class="text-sm text-zinc-500 leading-relaxed group-hover:text-zinc-400 transition-colors duration-300">
        {description}
    </p>
</div>
