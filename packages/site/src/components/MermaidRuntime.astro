---
/**
 * Draws any `<pre class="mermaid">` on the page (emitted by lib/rehype-mermaid-pre)
 * and nothing else.
 *
 * Included site-wide from Base.astro, but it costs a page without a diagram
 * nothing: the module checks for a mermaid node first and only then reaches for
 * the library, so mermaid lands in its own lazy chunk that docs pages, blog
 * posts and the homepage never request unless they actually have a diagram.
 *
 * Rendering happens in the browser rather than at build time on purpose. The
 * build-time alternative (rehype-mermaid → mermaid-isomorphic) needs a Chromium
 * installed during `vercel build`; a diagram is not worth putting a headless
 * browser on the critical path of every deploy.
 *
 * Theming follows the site's own rule (see styles/tokens.css): the neutral
 * ramp carries structure, and the three semantic colours are reserved for
 * verdicts. A diagram is structure, so it is neutral throughout -- a mermaid
 * default palette here would be the loudest thing on the page and would mean
 * something it does not.
 *
 * Mermaid derives shades from the colours it is given, so it needs values, not
 * `var()` references: they are read from the tokens at render time, and the
 * diagrams are drawn again from their source when the theme changes.
 */
---

<script>
  const nodes = document.querySelectorAll<HTMLElement>('pre.mermaid');

  if (nodes.length > 0) {
    const root = document.documentElement;
    // Hide the fence's source text only once we know we are going to replace
    // it, and only for as long as that takes. If the import or the parse
    // fails, the class comes off and the reader gets the diagram source
    // instead of an empty gap — the same thing they would have seen before
    // this component existed.
    root.classList.add('mermaid-pending');

    try {
      const { default: mermaid } = await import('mermaid');

      // 'JetBrains Mono Variable' is the family @fontsource-variable actually
      // registers; the bare name is kept after it as the local fallback.
      const mono = "'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace";

      const sources = Array.from(nodes, (n) => n.textContent ?? '');

      const draw = async () => {
        const css = getComputedStyle(root);
        const token = (name: string) => css.getPropertyValue(name).trim();
        const dark = css.colorScheme === 'dark';
        const tone = {
          surface: token('--c-panel'), // node fill
          surfaceAlt: token('--c-subtle'), // clusters, notes, alt rows
          border: token('--c-rule'),
          borderStrong: token('--c-rule-strong'),
          line: token('--c-ink-3'), // edges
          text: token('--c-ink'), // labels
          textDim: token('--c-ink-2'), // edge labels, secondary text
          ground: token('--c-ground'),
        };

        mermaid.initialize({
          startOnLoad: false,
          theme: 'base',
          // Diagrams are authored in this repo and the docs repo, never supplied
          // by a reader, but strict costs nothing here: `<br/>` line breaks still
          // work, and no diagram on either site uses click bindings.
          securityLevel: 'strict',
          fontFamily: mono,
          themeCSS: `
            .node rect, .node polygon, .node circle, .node path { stroke-width: 1px; }
            .edgeLabel { border-radius: 4px; }
          `,
          themeVariables: {
            darkMode: dark,
            background: 'transparent',
            fontFamily: mono,
            fontSize: '14px',

            primaryColor: tone.surface,
            primaryBorderColor: tone.borderStrong,
            primaryTextColor: tone.text,
            secondaryColor: tone.surfaceAlt,
            secondaryBorderColor: tone.border,
            secondaryTextColor: tone.text,
            tertiaryColor: tone.surfaceAlt,
            tertiaryBorderColor: tone.border,
            tertiaryTextColor: tone.textDim,

            mainBkg: tone.surface,
            nodeBorder: tone.borderStrong,
            nodeTextColor: tone.text,
            lineColor: tone.line,
            textColor: tone.textDim,
            titleColor: tone.text,

            // flowchart
            clusterBkg: tone.surfaceAlt,
            clusterBorder: tone.border,
            edgeLabelBackground: tone.ground,
            defaultLinkColor: tone.line,

            // sequence
            actorBkg: tone.surface,
            actorBorder: tone.borderStrong,
            actorTextColor: tone.text,
            actorLineColor: tone.border,
            signalColor: tone.line,
            signalTextColor: tone.textDim,
            labelBoxBkgColor: tone.surfaceAlt,
            labelBoxBorderColor: tone.border,
            labelTextColor: tone.text,
            loopTextColor: tone.textDim,
            noteBkgColor: tone.surfaceAlt,
            noteBorderColor: tone.border,
            noteTextColor: tone.text,
            activationBkgColor: tone.surfaceAlt,
            activationBorderColor: tone.borderStrong,
            sequenceNumberColor: tone.ground,

            // state / flowchart shared
            altBackground: tone.surfaceAlt,
            compositeBackground: tone.surface,
            compositeBorder: tone.border,
            compositeTitleBackground: tone.surfaceAlt,
            labelColor: tone.text,
            errorBkgColor: tone.surfaceAlt,
            errorTextColor: tone.textDim,
          },
        });

        nodes.forEach((n, i) => {
          n.removeAttribute('data-processed');
          n.textContent = sources[i];
        });
        await mermaid.run({ nodes: Array.from(nodes) });
      };

      await draw();
      // The theme toggle announces itself (see SiteNav); a reader who has not
      // chosen follows the system, which can change under an open page.
      document.addEventListener('themechange', () => void draw());
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => void draw());
    } catch (err) {
      console.error('[mermaid] diagram rendering failed, showing source', err);
    } finally {
      root.classList.remove('mermaid-pending');
    }
  }
</script>
