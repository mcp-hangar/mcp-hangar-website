---
/**
 * The product in one element: what a policy answered about one call.
 *
 * Three answers, the only three hues on the site: `allow`, `deny`, and `hold`
 * for a call that is neither yet (an approval pending). The word is never
 * optional. Colour tells you the verdict faster, but it is the second
 * encoding, not the first -- screen readers, printouts, and about one man in
 * twelve get the same information from the text.
 *
 * Lowercase and in the data face, because this is the word the record carries,
 * not a badge someone designed: `hangar.call.outcome=deny`.
 */
interface Props {
    verdict: "allow" | "deny" | "hold";
    /**
     * What the wire actually carries beside the verdict, e.g. `isError: true`.
     *
     * Not a JSON-RPC error code: a policy denial does not have one.
     * `EgressPolicyDeniedError` carries no code, and the flat path answers a
     * refused call with `CallToolResult(isError=True)` plus the reason as text.
     */
    code?: string;
    size?: "sm" | "md";
    class?: string;
}

const { verdict, code, size = "md", class: className = "" } = Astro.props;

const tone = {
    allow: "bg-allow-tint text-allow",
    deny: "bg-deny-tint text-deny",
    hold: "bg-hold-tint text-hold",
}[verdict];

const dims = {
    sm: "text-xs px-1.5 py-px gap-1.5",
    md: "text-sm px-2 py-0.5 gap-2",
}[size];
---

<span class={`verdict inline-flex items-center font-mono rounded-sm ${tone} ${dims} ${className}`}>
    {verdict}
    {code && <span class="font-normal">{code}</span>}
</span>
