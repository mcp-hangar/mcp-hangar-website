---
/**
 * The ordered gates a call meets, in one place, in three sizes.
 *
 * The order is the content. Everything else on the site can be rearranged for
 * emphasis; this cannot, because top-to-bottom here is real execution order —
 * egress is last because it fires immediately before upstream I/O, and a
 * diagram that reordered it would be lying about the product.
 *
 * Sizes:
 *   full     the Learn hub's interactive seam. Emits `.ctl` buttons carrying
 *            `data-filter`, which the hub's own script wires to its card grid.
 *            The filtering behaviour deliberately stays on the page: it is a
 *            relationship between the diagram and a grid this component cannot
 *            see, so it is page behaviour, not component behaviour.
 *   compact  a horizontal strip for the homepage — the shape of the pipeline
 *            without the detail.
 *   mini     an inline marker for a card: the gates that card covers are lit,
 *            the rest stay dim.
 *
 * `full` renders the same class names the Learn hub already styles, so the hub
 * is byte-identical after extraction. `compact` and `mini` carry their own
 * styles and inherit the hub's custom properties when they happen to be in
 * scope, falling back to the zinc base when they are not.
 */
interface Props {
    size?: "full" | "compact" | "mini";
    /** For `mini`: which gate letters to light, e.g. ["a", "f"]. */
    gates?: string[];
    class?: string;
}

const { size = "full", gates = [], class: className = "" } = Astro.props;

type Gate = {
    key: string;
    /** gate = a governance decision · rel = reliability · off = opt-in, off by default */
    kind: "gate" | "rel" | "off";
    label: string;
    detail: string;
    tag?: string;
    /** Learn slugs this gate points at, consumed by the hub's filter script. */
    filter: string;
    last?: boolean;
    note?: string;
    status?: string;
};

const GATES: Gate[] = [
    { key: "a", kind: "gate", label: "Tool-access authz", detail: "tenant / member scope",
      filter: "what-is-a-policy-enforcement-plane enforcement-plane-vs-api-gateway" },
    { key: "b", kind: "gate", label: "Tool-withdrawal check", detail: "per-tenant withdrawal",
      filter: "what-is-a-policy-enforcement-plane" },
    { key: "c", kind: "gate", label: "Tool-schema digest-pin verify", tag: "opt-in",
      detail: "schema drift fails closed", filter: "digest-pinning" },
    { key: "d", kind: "rel", label: "Circuit-breaker / health", detail: "reliability",
      filter: "the-request-path" },
    { key: "e", kind: "off", label: "Interceptor validators", tag: "off",
      detail: "opt-in · off by default", filter: "the-request-path" },
    { key: "f", kind: "gate", label: "Approval gate", detail: "human-in-the-loop",
      filter: "the-l7-mcpegresspolicy-language" },
    { key: "g", kind: "rel", label: "Concurrency / backpressure", detail: "reliability",
      filter: "the-request-path" },
    { key: "h", kind: "off", label: "Interceptor mutators — request", tag: "off",
      detail: "opt-in · off by default", filter: "the-request-path" },
    { key: "i", kind: "gate", last: true, label: "Egress L7 policy",
      note: "last gate before the wire",
      detail: "tool + arguments — fires inside invoke_tool, right before upstream I/O",
      status: "core v1.6.0+ · end-to-end needs operator v0.14.0+",
      filter: "the-l7-mcpegresspolicy-language write-your-first-mcpegresspolicy from-install-to-a-governed-deny" },
];

const kindClass = { gate: "is-gate", rel: "is-rel", off: "is-off" };
const lit = new Set(gates);
---

{size === "full" && (
    <div class="seam">
        <div class="seamlabel">The enforcement pipeline</div>
        <div class="seamsub">ordered — top → bottom is real execution order</div>
        <div class="pipelegend">
            <span><i class="k k-gate"></i> governance gate</span>
            <span><i class="k k-rel"></i> reliability</span>
            <span><i class="k k-off"></i> opt-in · off</span>
        </div>
        <ol class="pipe">
            {GATES.map(g => (
                <li>
                    <button
                        type="button"
                        class={`ctl step ${kindClass[g.kind]}${g.last ? " is-l7" : ""}`}
                        data-theme="enforcement"
                        data-filter={g.filter}
                        data-active="false"
                    >
                        <span class="acc"></span>
                        <span class="sord">{g.key}</span>
                        <span class="sbody">
                            <span class="sh">
                                {g.label}{(g.tag || g.note) && " "}
                                {g.tag && <span class={`tag ${g.tag === "off" ? "off" : "opt"}`}>{g.tag}</span>}
                                {g.note && <span class="slast">{g.note}</span>}
                            </span>
                            <span class="sd">{g.detail}</span>
                            {g.status && <span class="sstat">{g.status}</span>}
                        </span>
                    </button>
                </li>
            ))}
        </ol>
    </div>
)}

{size === "compact" && (
    <ol class={`pipeline-compact ${className}`} aria-label="The enforcement pipeline, in order">
        {GATES.map(g => (
            <li class={`pc-step pc-${g.kind}${g.last ? " pc-last" : ""}`}>
                <span class="pc-ord" aria-hidden="true">{g.key}</span>
                <span class="pc-label">{g.label}</span>
                {g.tag && <span class="pc-tag">{g.tag}</span>}
            </li>
        ))}
    </ol>
)}

{size === "mini" && (
    <ol
        class={`pipeline-mini ${className}`}
        aria-label={`Gates covered: ${GATES.filter(g => lit.has(g.key)).map(g => g.label).join(", ")}`}
    >
        {GATES.map(g => (
            <li
                class={`pm-dot${lit.has(g.key) ? " is-lit" : ""}`}
                title={g.label}
            >
                <span aria-hidden="true">{g.key}</span>
                {lit.has(g.key) && <span class="sr-only">{g.label}</span>}
            </li>
        ))}
    </ol>
)}

<style>
    /* `full`'s styles, lifted out of the Learn hub with it.
     *
     * They had to move: Astro scopes a page's <style> to that page's elements,
     * so the moment the markup became a component the hub's rules stopped
     * matching it and the seam rendered unstyled. Selectors here drop the
     * `.learn-hub` ancestor for the same reason — it belongs to the page, and a
     * scoped selector naming it would never match.
     *
     * The custom properties (--line, --panel, --brand, …) are deliberately not
     * redefined: they inherit from the hub through the DOM, and the fallbacks
     * below cover the component being used anywhere else.
     */
  .ctl { --acc: var(--faint); }
  .ctl {
    appearance: none; font: inherit; text-align: left; cursor: pointer; color: inherit;
    background: var(--panel); border: 1px solid var(--line); border-radius: 12px;
    position: relative; overflow: hidden; transition: transform .15s, border-color .15s, box-shadow .15s;
  }
  .ctl:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--muted) 45%, var(--line)); }
  .ctl:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .ctl[data-active="true"] { border-color: var(--brand); box-shadow: 0 0 0 2px color-mix(in srgb, var(--brand) 70%, transparent) inset; }
  .ctl .acc { position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--brand); opacity: 0; transition: opacity .15s; }
  .ctl[data-active="true"] .acc { opacity: 1; }
  .seam,
  .respside { width: 100%; max-width: 480px; }
  .seam {
    border: 1px solid color-mix(in srgb, var(--brand) 40%, var(--line));
    background: linear-gradient(180deg, var(--brand-dim), var(--panel)); border-radius: 12px; padding: 14px 13px;
  }
  .seam .seamlabel { text-align: center; font-size: 12px; text-transform: uppercase; letter-spacing: .1em; color: var(--brand); font-weight: 800; }
  .seam .seamsub { text-align: center; font-size: 12px; color: var(--faint); margin: 2px 0 8px; }
  .pipelegend { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; margin-bottom: 10px; font-size: 11px; color: var(--faint); }
  .pipelegend span { display: inline-flex; align-items: center; gap: 5px; }
  .pipelegend .k { width: 9px; height: 9px; border-radius: 2px; }
  .pipelegend .k-gate { background: var(--ink-2); }
  .pipelegend .k-rel { background: var(--faint); opacity: .7; }
  .pipelegend .k-off { background: transparent; border: 1px dashed var(--line-2); }
  .pipe { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; position: relative; }
  .step { width: 100%; padding: 10px 12px; display: flex; align-items: flex-start; gap: 10px; }
  .step .sord {
    flex: 0 0 auto; width: 18px; height: 18px; border-radius: 50%; display: grid; place-items: center; margin-top: 1px;
    font-family: var(--font-mono, ui-monospace, monospace); font-size: 11px; font-weight: 700;
    color: var(--muted); background: var(--raise); border: 1px solid var(--line-2);
  }
  .step .sbody { display: flex; flex-direction: column; min-width: 0; }
  .step .sh { font-weight: 700; font-size: 14px; color: var(--ink); display: flex; align-items: center; gap: 7px; flex-wrap: wrap; }
  .step .sd { font-size: 12px; color: var(--muted); margin-top: 2px; }
  .step .sstat { font-size: 11px; color: var(--faint); margin-top: 4px; }
  .step.is-gate { border-color: var(--line-2); }
  .step.is-gate .sord { color: var(--ink); background: var(--panel); }
  .step.is-rel { background: var(--panel-2); opacity: .82; }
  .step.is-rel .sh { color: var(--ink-2); font-weight: 600; }
  .step.is-off { border-style: dashed; background: transparent; opacity: .62; }
  .step.is-off .sh { color: var(--muted); font-weight: 600; }
  .step.is-l7 { border-color: color-mix(in srgb, var(--brand) 45%, var(--line)); background: color-mix(in srgb, var(--brand-dim) 70%, var(--panel)); }
  .step.is-l7 .slast {
    font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: .05em;
    color: var(--brand); border: 1px solid color-mix(in srgb, var(--brand) 45%, transparent); border-radius: 5px; padding: 1px 5px;
  }
  .tag { font-size: 9.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; padding: 2px 6px; border-radius: 5px; white-space: nowrap; }
  .tag.opt { background: var(--raise); color: var(--muted); }
  .tag.off { background: transparent; color: var(--faint); border: 1px dashed var(--line-2); }
  .tag.v2 { background: var(--preview-bg); color: var(--preview); }

    /* compact — the shape of the pipeline, no detail. Horizontal, scrolls
       rather than wrapping, so the order stays readable as an order. */
    .pipeline-compact {
        display: flex;
        gap: 6px;
        overflow-x: auto;
        list-style: none;
        margin: 0;
        padding: 0 0 4px;
    }
    .pc-step {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        border: 1px solid var(--line-2, #3f3f46);
        border-radius: 10px;
        background: var(--panel, rgba(24, 24, 27, 0.6));
        padding: 8px 12px;
        font-size: 13px;
        color: var(--ink-2, #d4d4d8);
    }
    .pc-ord {
        font-family: var(--font-mono, ui-monospace, monospace);
        font-size: 11px;
        color: var(--faint, #71717a);
        border: 1px solid var(--line, #27272a);
        border-radius: 4px;
        padding: 0 5px;
    }
    /* Reliability steps are not decisions, so they read quieter than gates. */
    .pc-rel { opacity: 0.75; }
    /* Off-by-default is the one state that takes a hue (WS-1: state-optin). */
    .pc-off { border-color: color-mix(in srgb, var(--color-state-optin) 40%, transparent); }
    .pc-tag {
        font-family: var(--font-mono, ui-monospace, monospace);
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-state-optin-soft);
    }
    .pc-last { border-color: var(--muted, #a1a1aa); }

    /* mini — which gates a card covers. Letters, not colour: the lit/dim
       distinction has to survive being printed in greyscale (C11). */
    .pipeline-mini {
        display: flex;
        gap: 4px;
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .pm-dot {
        font-family: var(--font-mono, ui-monospace, monospace);
        font-size: 10px;
        line-height: 1;
        width: 18px;
        height: 18px;
        display: grid;
        place-items: center;
        border-radius: 4px;
        border: 1px solid var(--line, #27272a);
        color: var(--faint, #52525b);
        background: transparent;
    }
    .pm-dot.is-lit {
        border-color: var(--muted, #a1a1aa);
        color: var(--ink, #fafafa);
        background: rgba(161, 161, 170, 0.12);
        font-weight: 700;
    }
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }
</style>
