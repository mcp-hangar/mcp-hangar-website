---
import data from "../data/security-advisories.json";

/**
 * MCP Hangar's own published security advisories, from the committed snapshot
 * of core's GitHub Security Advisories (scripts/refresh-advisories.mjs, run
 * daily by refresh-advisories.yml). Published records only; the script drops
 * anything else before it reaches this file.
 *
 * Severity is a word, not a colour. On this site a hue means allow or deny.
 */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

export interface Advisory {
  ghsaId: string;
  cveId: string | null;
  severity: string;
  summary: string;
  publishedAt: string;
  affectedVersions: string | null;
  patchedVersions: string | null;
  url: string;
}

const advisories = data.advisories as Advisory[];

const fmtDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });
---

<ul class={`advisory-list not-prose divide-y divide-zinc-800/60 border-y border-zinc-800/60 ${className}`}>
  {
    advisories.map((a) => (
      <li id={a.ghsaId.toLowerCase()}>
        <a
          href={a.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col gap-1.5 py-4 transition-colors"
        >
          <span class="flex flex-wrap items-baseline gap-x-3 gap-y-1 font-mono text-xs text-zinc-400">
            <time datetime={a.publishedAt}>{fmtDate(a.publishedAt)}</time>
            <span class="uppercase tracking-wider">{a.severity}</span>
            <span>{a.ghsaId}</span>
            {a.cveId && <span>{a.cveId}</span>}
          </span>
          <span class="advisory-summary text-zinc-300 group-hover:text-zinc-100 transition-colors">{a.summary}</span>
          <span class="text-xs text-zinc-400">
            {a.patchedVersions
              ? `Fixed in ${a.patchedVersions}`
              : `Affects ${a.affectedVersions ?? "see advisory"}`}
          </span>
        </a>
      </li>
    ))
  }
  {advisories.length === 0 && <li class="py-4 text-sm text-zinc-400">No advisories published yet.</li>}
</ul>

<style>
  /* Also rendered inside the CVE ledger's prose, where `.docs-article a`
     underlines every link. Each entry is one link; underlining all three of
     its lines is noise. Scoped, so this outranks that rule. */
  .advisory-list a {
    text-decoration: none;
  }
  .advisory-list a:hover .advisory-summary,
  .advisory-list a:focus-visible .advisory-summary {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
