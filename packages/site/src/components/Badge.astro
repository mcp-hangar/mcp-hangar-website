---
interface Props {
    pulse?: boolean;
    class?: string;
}
const { pulse = true, class: className = "" } = Astro.props;
---

<div
    class={`inline-flex items-center gap-2 px-3 py-1 rounded-full bg-subtle border border-rule-strong text-ink-2 text-sm cursor-default hover:bg-subtle transition-all ${className}`}
    role="status"
>
    {pulse && <span class="w-2 h-2 rounded-full bg-ink-2 animate-pulse" aria-hidden="true"/>}
    <slot />
</div>
