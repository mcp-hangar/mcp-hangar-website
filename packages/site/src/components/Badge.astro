---
interface Props {
    pulse?: boolean;
    class?: string;
}
const { pulse = true, class: className = "" } = Astro.props;
---

<div
    class={`inline-flex items-center gap-2 px-2 py-0.5 rounded-sm border border-rule text-ink-2 font-mono text-xs ${className}`}
>
    {pulse && <span class="w-1.5 h-1.5 rounded-full bg-ink-3" aria-hidden="true"/>}
    <slot />
</div>
