---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MermaidRuntime from '../components/MermaidRuntime.astro';
import { DESCRIPTION, VERSION } from '../config';
import { OPERATING_SYSTEMS, SIEM_FORMATS } from '../lib/product-facts';

import { ogPathFor } from '../og/resolve';

interface Props {
    title: string;
    description: string;
    path: string;
    keywords?: string;
    /** Keeps a page out of search results. Also exempts it from the OG build gate. */
    noindex?: boolean;
}

const { title, description, path, keywords, noindex } = Astro.props;

// Per-page OG card, generated at build by src/pages/og/[...slug].png.ts.
// Anything unmapped falls back to the site-wide asset and is reported at the
// end of the build (see astro.config integration) rather than passing quietly.
const ogImage = ogPathFor(path);
const siteUrl = 'https://mcp-hangar.io';
const url = `${siteUrl}${path}`;
const defaultKeywords = "MCP, Model Context Protocol, runtime security, governance, policy enforcement, approvals, audit, identity, egress policy, Kubernetes, SIEM";
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- The theme, before anything paints. A reader who chose one with the
         toggle gets it back; one who has not follows the system through the
         media query in tokens.css, so nothing is set here and there is no
         flash of the wrong ground. Storage can throw (private windows, blocked
         site data), and a page that cannot remember a choice still renders. -->
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {
        // Storage is blocked: follow the system.
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords || defaultKeywords} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- The ground of each theme (tokens.css --c-ground). A meta cannot read a
         custom property, so these two are the only literals outside tokens.css. -->
    <meta name="theme-color" content="#f7f8f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111418" media="(prefers-color-scheme: dark)" />

    <!-- Structured data for AI/search -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "MCP Hangar",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": OPERATING_SYSTEMS,
      "url": siteUrl,
      "description": `${DESCRIPTION} Deterministic policy on the verdict path, attributable audit with identity, and SIEM export (${SIEM_FORMATS.join(", ")}). MIT-licensed and self-hosted.`,
      "license": "https://opensource.org/licenses/MIT",
      "softwareVersion": VERSION,
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "author": { "@type": "Organization", "name": "MCP Hangar", "url": siteUrl }
    })} />
</head>
<body class="bg-ground text-ink-2 font-sans antialiased min-h-screen flex flex-col">
    <SiteNav />
    <div class="flex-1">
        <slot />
    </div>
    <SiteFooter />
    <MermaidRuntime />
</body>
</html>
