{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "brand:sync": "node scripts/brand-sync.mjs",
    "advisories:refresh": "node scripts/refresh-advisories.mjs",
    "release-post": "node scripts/release-post.mjs",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude \"**/build-output.test.ts\" --exclude \"**/blog-jsonld.test.ts\" --exclude \"**/og-cards.test.ts\" --exclude \"**/mermaid-diagrams.test.ts\" --exclude \"**/learn-track.test.ts\"",
    "test:build": "vitest run src/__tests__/build-output.test.ts src/__tests__/blog-jsonld.test.ts src/__tests__/og-cards.test.ts src/__tests__/mermaid-diagrams.test.ts src/__tests__/learn-track.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@mcp-hangar/docs": "github:mcp-hangar/docs#e30794537efb8ac61315ba3a4271632a563b70a0",
    "@shikijs/rehype": "^4.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "gray-matter": "^4.0.3",
    "mermaid": "^12.3.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "unified": "^11.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@mdx-js/mdx": "^3.1.1",
    "@playwright/test": "^1.65.1",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/types": "^4.6.0",
    "fast-glob": "^3.3.3",
    "jsdom": "^31.0.1",
    "pagefind": "^1.6.0",
    "satori": "^0.63.2",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
