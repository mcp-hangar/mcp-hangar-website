{
  "buildCommand": "pnpm build",
  "outputDirectory": "packages/site/dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/install.sh",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/og-image.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.mcp-hangar.io"
        }
      ],
      "destination": "https://mcp-hangar.io/:path*",
      "permanent": true
    },
    {
      "source": "/docs/blog/:path*",
      "destination": "/blog/:path*",
      "permanent": true
    },
    {
      "source": "/docs/oss/:path*",
      "destination": "/docs/:path*",
      "permanent": true
    },
    {
      "source": "/docs/cloud/:path*",
      "destination": "/docs/:path*",
      "permanent": true
    },
    {
      "source": "/plans",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/waitlist",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/docs/development/BRANCH_PROTECTION",
      "destination": "https://github.com/mcp-hangar/docs/blob/main/development/BRANCH_PROTECTION.md",
      "permanent": true
    },
    {
      "source": "/docs/development/BRANCH_PROTECTION.md",
      "destination": "https://github.com/mcp-hangar/docs/blob/main/development/BRANCH_PROTECTION.md",
      "permanent": true
    },
    {
      "source": "/docs/development/CONTRIBUTING",
      "destination": "https://github.com/mcp-hangar/docs/blob/main/development/CONTRIBUTING.md",
      "permanent": true
    },
    {
      "source": "/docs/development/CONTRIBUTING.md",
      "destination": "https://github.com/mcp-hangar/docs/blob/main/development/CONTRIBUTING.md",
      "permanent": true
    },
