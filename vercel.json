      "permanent": true
    },
    {
      "source": "/docs/development/GIT_FLOW",
      "destination": "https://github.com/mcp-hangar/docs/blob/main/development/GIT_FLOW.md",
      "permanent": true
    },
    {
      "source": "/docs/development/GIT_FLOW.md",
      "destination": "https://github.com/mcp-hangar/docs/blob/main/development/GIT_FLOW.md",
      "permanent": true
    },
    {
